---
import SiteHeader from '../../../components/SiteHeader.astro';
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Калькулятор бюджета поездки в Нячанг — приехали.ком</title>
<meta name="description" content="Посчитайте примерный бюджет поездки в Нячанг: дни, человек, уровень комфорта и доп. расходы — итог в донгах и рублях по текущему курсу.">
<meta name="theme-color" content="#F4F6F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#F4F6F0; --bg-card:#FFFFFF; --ink:#16232B; --ink-soft:#4A5A5F; --line:#DAE1D3;
    --jade:#2F7B6D; --jade-dark:#204F46; --gold:#D9A441;
    --serif:"Newsreader",Georgia,serif; --sans:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif; --maxw:760px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{overflow-x:hidden;max-width:100%}
  img,iframe{max-width:100%}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  :focus-visible{outline:2px solid var(--jade);outline-offset:2px;border-radius:6px}

  main{padding-bottom:60px}
  h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.6rem,7vw,2.5rem);margin-bottom:8px}
  .lede{color:var(--ink-soft);margin-bottom:24px;font-size:.95rem}

  .card{background:var(--bg-card);border:1px solid var(--line);border-radius:16px;padding:22px;margin-bottom:20px;box-shadow:0 16px 32px -26px rgba(22,35,43,.25)}
  .field{margin-bottom:20px}
  .field:last-child{margin-bottom:0}
  .field-label{display:block;font-weight:600;font-size:.88rem;margin-bottom:9px}
  .seg{display:flex;gap:8px;flex-wrap:wrap}
  .seg button{font-family:var(--sans);font-size:.85rem;font-weight:600;padding:9px 16px;border-radius:999px;border:1.5px solid var(--line);background:#fff;color:var(--ink-soft);cursor:pointer;transition:all .15s}
  .seg button:hover{border-color:var(--jade)}
  .seg button.active{background:var(--jade);border-color:var(--jade);color:#fff}
  .style-opt{display:flex;flex-direction:column;gap:9px}
  .style-row{display:flex;align-items:center;gap:10px;padding:11px 14px;border:1.5px solid var(--line);border-radius:12px;cursor:pointer;transition:all .15s}
  .style-row:hover{border-color:var(--jade)}
  .style-row.active{border-color:var(--jade);background:rgba(47,123,109,.06)}
  .style-row input{accent-color:var(--jade);flex:none}
  .style-row .sr-text{font-size:.86rem}
  .style-row .sr-title{font-weight:600;display:block}
  .style-row .sr-range{color:var(--ink-soft);font-size:.78rem}
  .extra-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--line)}
  .extra-row:first-of-type{border-top:none}
  .extra-text{font-size:.86rem}
  .extra-sub{color:var(--ink-soft);font-size:.76rem}
  .stepper{display:flex;align-items:center;gap:10px}
  .stepper button{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--line);background:#fff;font-size:1rem;font-weight:600;color:var(--jade-dark);cursor:pointer}
  .stepper button:hover{border-color:var(--jade)}
  .stepper span{min-width:16px;text-align:center;font-weight:600}
  .toggle{position:relative;width:42px;height:24px;flex:none}
  .toggle input{opacity:0;width:0;height:0}
  .toggle .slider{position:absolute;inset:0;background:var(--line);border-radius:999px;cursor:pointer;transition:background .15s}
  .toggle .slider::before{content:'';position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:transform .15s}
  .toggle input:checked + .slider{background:var(--jade)}
  .toggle input:checked + .slider::before{transform:translateX(18px)}

  .result{background:var(--jade-dark);color:#fff;border-radius:16px;padding:24px 22px}
  .result h2{font-family:var(--serif);font-weight:500;font-size:1.2rem;margin-bottom:14px}
  .result-row{display:flex;justify-content:space-between;font-size:.86rem;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.15)}
  .result-row.total{border-bottom:none;padding-top:14px;font-size:1rem;font-weight:600}
  .result-row span:last-child{font-weight:600}
  .result-total-vnd{font-family:var(--serif);font-size:1.9rem;font-weight:500;margin:4px 0 2px}
  .result-total-rub{color:rgba(255,255,255,.75);font-size:.86rem}
  .result-note{color:rgba(255,255,255,.75);font-size:.76rem;margin-top:16px;line-height:1.5}
  .result-note a{color:#fff;text-decoration:underline}

  footer{padding:24px 0 40px;border-top:1px solid var(--line)}
  .footer__row{display:flex;justify-content:space-between;max-width:var(--maxw);margin:0 auto;padding:0 24px;font-family:var(--serif);color:var(--jade-dark)}
  .footer__muted{font-family:var(--sans);color:var(--ink-soft);font-size:.85rem}
</style>
</head>
<body>
<SiteHeader />

<main class="wrap">
  <h1>Калькулятор бюджета поездки в Нячанг</h1>
  <p class="lede">Прикиньте, сколько денег брать с собой. Расчёт на повседневные расходы — без учёта перелёта и жилья, их добавьте отдельно. Ориентиры цен взяты из нашей статьи «<a href="/tourist/ceny/ceny-v-nyachange/" style="color:var(--jade-dark);text-decoration:underline">Цены в Нячанге</a>».</p>

  <div class="card">
    <div class="field">
      <span class="field-label">Сколько человек?</span>
      <div class="seg" id="peopleSeg">
        <button type="button" data-val="1" class="active">1</button>
        <button type="button" data-val="2">2</button>
        <button type="button" data-val="3">3</button>
        <button type="button" data-val="4">4</button>
      </div>
    </div>

    <div class="field">
      <span class="field-label">На сколько дней?</span>
      <div class="seg" id="daysSeg">
        <button type="button" data-val="7" class="active">7</button>
        <button type="button" data-val="10">10</button>
        <button type="button" data-val="14">14</button>
        <button type="button" data-val="21">21</button>
        <button type="button" data-val="30">30</button>
      </div>
    </div>

    <div class="field">
      <span class="field-label">Как отдыхаете?</span>
      <div class="style-opt" id="styleOpt">
        <label class="style-row active">
          <input type="radio" name="style" value="econ" checked>
          <span class="sr-text"><span class="sr-title">Экономно</span><span class="sr-range">≈ 650 000 ₫ в день на человека</span></span>
        </label>
        <label class="style-row">
          <input type="radio" name="style" value="normal">
          <span class="sr-text"><span class="sr-title">Обычный отпуск</span><span class="sr-range">≈ 1 250 000 ₫ в день на человека</span></span>
        </label>
        <label class="style-row">
          <input type="radio" name="style" value="comfort">
          <span class="sr-text"><span class="sr-title">С комфортом</span><span class="sr-range">от 2 200 000 ₫ в день на человека</span></span>
        </label>
      </div>
    </div>
  </div>

  <div class="card">
    <span class="field-label" style="margin-bottom:4px">Дополнительные расходы</span>
    <p class="extra-sub" style="margin-bottom:10px">Добавятся сверху к повседневному бюджету</p>

    <div class="extra-row">
      <div><span class="extra-text">VinWonders</span><br><span class="extra-sub">1 050 000 ₫ за взрослый билет, на каждого человека</span></div>
      <label class="toggle"><input type="checkbox" id="vinwonders"><span class="slider"></span></label>
    </div>
    <div class="extra-row">
      <div><span class="extra-text">Экскурсии</span><br><span class="extra-sub">≈ 800 000 ₫ за экскурсию, на каждого человека</span></div>
      <div class="stepper" id="excStepper">
        <button type="button" data-d="-1">−</button><span id="excVal">0</span><button type="button" data-d="1">+</button>
      </div>
    </div>
    <div class="extra-row">
      <div><span class="extra-text">Трансфер аэропорт ↔ отель</span><br><span class="extra-sub">≈ 688 000 ₫ туда-обратно, на группу</span></div>
      <label class="toggle"><input type="checkbox" id="transfer"><span class="slider"></span></label>
    </div>
    <div class="extra-row">
      <div><span class="extra-text">Массаж</span><br><span class="extra-sub">≈ 250 000 ₫ за раз, на каждого человека</span></div>
      <div class="stepper" id="massageStepper">
        <button type="button" data-d="-1">−</button><span id="massageVal">0</span><button type="button" data-d="1">+</button>
      </div>
    </div>
  </div>

  <div class="result">
    <h2 id="resultTitle">Нячанг на 7 дней для 1 человека</h2>
    <div class="result-row"><span>Повседневные расходы</span><span id="rDaily">—</span></div>
    <div class="result-row" id="rVinRow" style="display:none"><span>VinWonders</span><span id="rVin">—</span></div>
    <div class="result-row" id="rExcRow" style="display:none"><span>Экскурсии</span><span id="rExc">—</span></div>
    <div class="result-row" id="rTransferRow" style="display:none"><span>Трансфер из аэропорта</span><span id="rTransfer">—</span></div>
    <div class="result-row" id="rMassageRow" style="display:none"><span>Массаж</span><span id="rMassage">—</span></div>
    <div class="result-row total"><span>Итого</span><span></span></div>
    <div class="result-total-vnd" id="rTotalVnd">—</div>
    <div class="result-total-rub" id="rTotalRub">считаем курс…</div>
    <p class="result-note">Жильё и перелёт в расчёт не включены — добавьте их отдельно. Это ориентир по ценам 2026 года, не точный расчёт: реальные траты зависят от конкретных мест. Курс донга к рублю — текущий, на момент открытия страницы.</p>
  </div>
</main>

<footer>
  <div class="footer__row">
    <a href="/">приехали.ком</a>
    <span class="footer__muted">© 2026</span>
  </div>
</footer>

<script>
  const DAILY_RATE = { econ: 650000, normal: 1250000, comfort: 2200000 };
  const VIN_PRICE = 1050000;
  const EXC_PRICE = 800000;
  const TRANSFER_PRICE = 688000;
  const MASSAGE_PRICE = 250000;

  const state = { people: 1, days: 7, style: 'econ', vinwonders: false, excursions: 0, transfer: false, massage: 0 };
  let rubPerVnd = null;

  function setupSeg(id, key) {
    const seg = document.getElementById(id);
    seg.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', () => {
        seg.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        state[key] = Number(btn.dataset.val);
        render();
      });
    });
  }
  setupSeg('peopleSeg', 'people');
  setupSeg('daysSeg', 'days');

  document.querySelectorAll('#styleOpt .style-row').forEach((row) => {
    row.addEventListener('click', () => {
      document.querySelectorAll('#styleOpt .style-row').forEach((r) => r.classList.remove('active'));
      row.classList.add('active');
      state.style = row.querySelector('input').value;
      render();
    });
  });

  document.getElementById('vinwonders').addEventListener('change', (e) => { state.vinwonders = e.target.checked; render(); });
  document.getElementById('transfer').addEventListener('change', (e) => { state.transfer = e.target.checked; render(); });

  function setupStepper(id, valId, key, max = 10) {
    const el = document.getElementById(id);
    const valEl = document.getElementById(valId);
    el.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = Number(btn.dataset.d);
        state[key] = Math.max(0, Math.min(max, state[key] + d));
        valEl.textContent = state[key];
        render();
      });
    });
  }
  setupStepper('excStepper', 'excVal', 'excursions');
  setupStepper('massageStepper', 'massageVal', 'massage');

  const fmt = (n) => Math.round(n).toLocaleString('ru-RU') + ' ₫';

  function render() {
    const daily = DAILY_RATE[state.style] * state.people * state.days;
    const vin = state.vinwonders ? VIN_PRICE * state.people : 0;
    const exc = state.excursions * EXC_PRICE * state.people;
    const transfer = state.transfer ? TRANSFER_PRICE : 0;
    const massage = state.massage * MASSAGE_PRICE * state.people;
    const total = daily + vin + exc + transfer + massage;

    document.getElementById('resultTitle').textContent =
      `Нячанг на ${state.days} ${daysWord(state.days)} для ${state.people} ${peopleWord(state.people)}`;
    document.getElementById('rDaily').textContent = fmt(daily);

    toggleRow('rVinRow', 'rVin', vin);
    toggleRow('rExcRow', 'rExc', exc);
    toggleRow('rTransferRow', 'rTransfer', transfer);
    toggleRow('rMassageRow', 'rMassage', massage);

    document.getElementById('rTotalVnd').textContent = fmt(total);
    document.getElementById('rTotalRub').textContent = rubPerVnd
      ? `≈ ${Math.round(total * rubPerVnd).toLocaleString('ru-RU')} ₽`
      : 'считаем курс…';
  }

  function toggleRow(rowId, valId, amount) {
    const row = document.getElementById(rowId);
    if (amount > 0) {
      row.style.display = 'flex';
      document.getElementById(valId).textContent = fmt(amount);
    } else {
      row.style.display = 'none';
    }
  }

  function daysWord(n) {
    const mod10 = n % 10, mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return 'день';
    if ([2, 3, 4].includes(mod10) && ![12, 13, 14].includes(mod100)) return 'дня';
    return 'дней';
  }
  function peopleWord(n) {
    const mod10 = n % 10, mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return 'человека';
    return 'человек';
  }

  (async () => {
    try {
      const res = await fetch('https://open.er-api.com/v6/latest/USD');
      const data = await res.json();
      if (data.result !== 'success') throw new Error('bad response');
      rubPerVnd = data.rates.RUB / data.rates.VND;
    } catch (e) {
      rubPerVnd = null;
    }
    render();
  })();

  render();
</script>
</body>
</html>
