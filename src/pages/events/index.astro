---
import events from '../../data/events.js';

const sorted = [...events].sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>События и мероприятия — приехали.ком</title>
<meta name="description" content="Фестивали, рынки, встречи комьюнити в Нячанге.">
<meta name="theme-color" content="#F4F6F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#F4F6F0; --bg-card:#FFFFFF; --ink:#16232B; --ink-soft:#4A5A5F; --line:#DAE1D3;
    --jade:#2F7B6D; --jade-dark:#204F46; --gold:#D9A441;
    --serif:"Newsreader",Georgia,serif; --sans:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif; --maxw:760px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  :focus-visible{outline:2px solid var(--jade);outline-offset:2px;border-radius:6px}

  nav{padding:28px 0}
  .nav__row{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .nav__logo{font-family:var(--serif);font-size:1.3rem;font-weight:500;color:var(--jade-dark)}
  .nav__links{display:flex;gap:16px;font-size:.85rem;color:var(--ink-soft);flex-wrap:wrap}
  .nav__links a:hover{color:var(--jade-dark)}

  main{padding-bottom:60px}
  h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.9rem,4vw,2.5rem);margin-bottom:8px}
  .lede{color:var(--ink-soft);margin-bottom:30px;font-size:.95rem}

  .list{display:flex;flex-direction:column;gap:10px}
  .item{display:block;background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 20px;transition:border-color .15s,transform .15s}
  .item:hover{border-color:var(--jade);transform:translateY(-2px)}
  .item__meta{display:flex;gap:14px;font-size:.72rem;color:var(--jade-dark);font-weight:600;margin-bottom:8px}
  .item h2{font-family:var(--serif);font-weight:500;font-size:1.1rem;margin-bottom:4px}
  .item p{color:var(--ink-soft);font-size:.86rem}

  footer{padding:24px 0 40px;border-top:1px solid var(--line)}
  .footer__row{display:flex;justify-content:space-between;max-width:var(--maxw);margin:0 auto;padding:0 24px;font-family:var(--serif);color:var(--jade-dark)}
  .footer__muted{font-family:var(--sans);color:var(--ink-soft);font-size:.85rem}
</style>
</head>
<body>
<nav>
  <div class="nav__row">
    <a class="nav__logo" href="/">приехали.ком</a>
    <div class="nav__links">
      <a href="/blog/">Блог</a>
      <a href="/news/">Новости</a>
      <a href="/events/">События</a>
      <a href="/qa/">Вопрос-ответ</a>
      <a href="/favorites/">♡ Избранное</a>
    </div>
  </div>
</nav>

<main class="wrap">
  <h1>События</h1>
  <p class="lede">Фестивали, рынки, встречи комьюнити — что происходит в городе.</p>

  <div class="list">
    {sorted.map((e) => (
      <a class="item" href={`/events/${e.slug}/`}>
        <div class="item__meta"><span>📅 {e.when}</span><span>📍 {e.place}</span></div>
        <h2>{e.title}</h2>
        <p>{e.summary}</p>
      </a>
    ))}
  </div>
</main>

<footer>
  <div class="footer__row">
    <a href="/">приехали.ком</a>
    <span class="footer__muted">© 2026</span>
  </div>
</footer>
</body>
</html>
