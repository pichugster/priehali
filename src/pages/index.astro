<script is:inline>
  // ---------- Избранное (localStorage, без логина) ----------
  const FAV_KEY = 'priehali_favorites';
  function getFavs(){ try{ return JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e){ return []; } }
  function saveFavs(list){ localStorage.setItem(FAV_KEY, JSON.stringify(list)); }
  function isFav(url){ return getFavs().some(f=>f.url===url); }
  function toggleFav(btn){
    const url=btn.dataset.url, title=btn.dataset.title, icon=btn.dataset.icon;
    let list=getFavs();
    if(list.some(f=>f.url===url)){ list=list.filter(f=>f.url!==url); btn.classList.remove('on'); btn.textContent='♡'; }
    else { list.push({url,title,icon}); btn.classList.add('on'); btn.textContent='♥'; }
    saveFavs(list);
  }
  function refreshFavButtons(root=document){
    root.querySelectorAll('.favbtn').forEach(btn=>{
      const on=isFav(btn.dataset.url);
      btn.classList.toggle('on',on);
      btn.textContent=on?'♥':'♡';
    });
  }
  function favBtn(url,title,icon){
    const safeTitle=String(title).replace(/"/g,'&quot;');
    return `<button class="favbtn" data-url="${url}" data-title="${safeTitle}" data-icon="${icon}" onclick="event.preventDefault();event.stopPropagation();toggleFav(this)" aria-label="В избранное">♡</button>`;
  }

  let activeTab='tourist';
  const tabs=document.querySelectorAll('.ticket__tab'), fieldsets=document.querySelectorAll('.fields');
  const cardsEl=document.getElementById('cards'), titleEl=document.getElementById('picksTitle'), subEl=document.getElementById('picksSub');

  const multi={ t_int:new Set(['all']), m_comp:new Set(['solo']) };

  document.querySelectorAll('.chip').forEach(chip=>{
    chip.addEventListener('click',()=>{
      const group=chip.dataset.group, value=chip.dataset.value, set=multi[group];
      const groupChips=[...document.querySelectorAll(`.chip[data-group="${group}"]`)];
      const resetValue = group==='t_int' ? 'all' : 'solo';

      if(value===resetValue){
        set.clear(); set.add(resetValue);
      } else {
        set.delete(resetValue);
        if(set.has(value)) set.delete(value); else set.add(value);
        if(set.size===0) set.add(resetValue);
      }
      groupChips.forEach(c=>c.classList.toggle('on', set.has(c.dataset.value)));
      render();
    });
  });

  function card(ic,t,d,href){ if(href) return `<a class="card" href="${href}">${favBtn(href,t,ic)}<div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="go">Открыть →</span></a>`; return `<div class="card"><div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="soon">Скоро</span></div>`; }
  function val(id,def){ const el=document.getElementById(id); return el?el.value:def; }

  const touristCards=[
    {ic:'🍜',t:'Где поесть',d:'Кафе, стритфуд, рестораны',tag:'food',slug:'eda'},
    {ic:'☕',t:'Кофе с видом',d:'Атмосферные кофейни, куда идут не ради еды',tag:'food',slug:'kofe'},
    {ic:'🏖',t:'Пляжные клубы',d:'Где провести день у моря',tag:'beach',slug:'plyazhi'},
    {ic:'🎉',t:'Тусовки',d:'Бары и вечеринки',tag:'party',slug:'tusovki'},
    {ic:'🗺',t:'Экскурсии',d:'Острова, водопады, туры',tag:'tours',slug:'ekskursii'},
    {ic:'💆',t:'Массажи и спа',d:'Проверенные места',tag:null,slug:'spa'},
    {ic:'🛵',t:'Аренда байка',d:'Где брать и как не влететь',tag:null,slug:'bayk'},
    {ic:'🏨',t:'Где остановиться',d:'Районы и отели',tag:null,slug:'gde-zhit'},
    {ic:'💸',t:'Цены',d:'Сколько брать с собой и как считать',tag:null,slug:'ceny'},
    {ic:'📶',t:'Связь',d:'eSIM, симка и интернет для туриста',tag:null,slug:'svyaz'},
    {ic:'🎁',t:'Подарки и шоппинг',d:'Что привезти домой и где купить',tag:null,slug:'shopping'},
  ];

  function render(){
    let title='',sub='',cards=[];
    if(activeTab==='tourist'){
      title='Подборки для туриста';
      sub=val('t_exp','first')==='first'?'Впервые в Нячанге — вот с чего начать':'Ты уже был — копнём глубже';
      const chosen=multi.t_int;
      const showAll=chosen.has('all');
      cards=touristCards.filter(c=>c.tag===null || showAll || chosen.has(c.tag)).map(c=>card(c.ic,c.t,c.d,`/tourist/${c.slug}/`));
    } else if(activeTab==='move'){
      const incVal=val('m_inc','income');
      const inc={income:'С доходом',savings:'С накоплениями',none:'Без дохода'}[incVal];
      const comp=multi.m_comp;
      const compLabels={solo:'один',couple:'парой',family:'с детьми',pet:'с питомцем'};
      title='Переезд в Нячанг';
      sub=inc+' · '+[...comp].map(v=>compLabels[v]).join(', ');
      if(incVal==='none') cards.push(card('🧑‍💻','Научиться зарабатывать','Удалённый доход с нуля — на pichugster','https://pichugster.com').replace('class="card"','class="card feat"'));
      cards.push(
        card('🛂','Виза','Как въехать и продлевать','/move/viza/'),
        card('🏠','Жильё надолго','Районы, цены, договоры','/move/zhile/'),
        card('🏦','Банки и деньги','Карты и как платить','/move/banki/'),
        card('📶','Симка и интернет','Связь с первого дня','/move/internet/'),
        card('🛵','Транспорт','Байк, права, аренда','/move/transport/'),
        card('🩺','Медицина','Клиники и страховка','/move/medicina/'),
        card('💸','Сколько нужно денег','Стартовый бюджет и как считать','/move/byudzhet/'),
        card('🤝','Комьюнити','Где найти своих','/move/komyuniti/')
      );
      if(comp.has('family')) cards.push(card('🎒','Школы и садики','Куда устроить детей','/move/shkoly/'));
      if(comp.has('pet')) cards.push(card('🐾','Ввоз питомца','Документы и жильё','/move/pitomec/'));
      if(comp.has('couple')) cards.push(card('👫','Жильё для двоих','Совместный бюджет','/move/zhile-dvoih/'));
      if(comp.has('solo') && comp.size===1) cards.push(card('🧳','Коливинги','Как не заскучать и найти своих','/move/kolivingi/'));
    } else {
      title='Живу тут'; sub='Комьюнити, быт и всё, что важно уже после переезда';
      cards=[
        card('🤝','Комьюнити','Встречи, чаты, движухи для своих','/live/komyuniti-tut/'),
        card('🛂','Продление визы','Что менять и когда','/live/prodlenie-vizy/'),
        card('💰','Жизнь как местному','Где дешевле, без туристической наценки','/live/mestnye-ceny/'),
        card('🧑‍🤝‍🧑','Нетворкинг','Где искать связи и знакомства','/live/networking/'),
        card('🏠','Аренда на год+','Долгосрочные условия и договоры','/live/arenda-god/'),
        card('🩺','Свой врач','Проверенные клиники для долгой жизни','/live/svoy-vrach/'),
        card('💈','Барбершопы','Проверенные мастера для мужской стрижки','/live/barbershopy/'),
        card('💅','Женская бьюти','Маникюр, ресницы, волосы, косметология','/live/zhenskaya-byuti/'),
        card('🎾','Теннис, падел и пиклбол','Корты и клубы для регулярных тренировок','/live/tennis-padel-pickleball/'),
        card('🏋️','Спорт и досуг','Залы, йога, сёрф, паделл — для своих','/live/sport-i-dosug/'),
        card('🔧','Мастера на все руки','Электрик, сантехник, мелкий ремонт','/live/mastera/'),
        card('🛠','Байк-сервис','Где чинят байк, а не разводят на ровном месте','/live/bayk-servis/'),
        card('🧹','Клининг','Уборка квартир на разовой и постоянной основе','/live/klining/'),
        card('🦷','Стоматологи','Проверенные клиники и врачи','/live/stomatologi/'),
        card('⚖️','Юристы и бухгалтеры','Визы, регистрация бизнеса, налоги','/live/yuristy-buhgaltery/'),
        card('🧠','Психологи','Поддержка и адаптация на русском и английском','/live/psihologi/'),
        card('🧸','Няни и детские сады','Куда пристроить ребёнка и кому доверить','/live/nyani-i-sady/'),
        card('📚','Репетиторы и языки','Английский, вьетнамский, школьные предметы','/live/repetitory-i-yazyki/'),
        card('📷','Фотографы и видеографы','Съёмка для себя, семьи или бизнеса','/live/fotografy-i-videografy/'),
      ];
    }
    titleEl.textContent=title; subEl.textContent=sub; cardsEl.innerHTML=cards.join(''); refreshFavButtons(cardsEl);
  }

  tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>x.classList.remove('active'));t.classList.add('active');activeTab=t.dataset.tab;fieldsets.forEach(f=>f.hidden=f.dataset.fields!==activeTab);render();}));
  document.querySelectorAll('.fields select').forEach(s=>s.addEventListener('change',render));
  document.getElementById('go').addEventListener('click',()=>{render();document.getElementById('picks').scrollIntoView({behavior:'smooth',block:'start'});});
  render();

</script>
</body>
</html>
