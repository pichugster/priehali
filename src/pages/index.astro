---
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import news from '../data/news.js';
import blog from '../data/blog.js';
import events from '../data/events.js';
import topics from '../data/topics.js';

const articleEntries = await getCollection('articles');
const articles = articleEntries.map((e) => e.data);

// Самая свежая запись из новостей/блога/событий — для полоски Breaking News
const feed = [
  ...news.map((n) => ({ ...n, kind: 'news', href: `/news/${n.slug}/` })),
  ...blog.map((b) => ({ ...b, kind: 'blog', href: `/blog/${b.slug}/` })),
  ...events.map((e) => ({ ...e, kind: 'events', href: `/events/${e.slug}/` })),
].sort((a, b) => new Date(b.date) - new Date(a.date));

const breaking = feed[0];

// Editor's Pick — не должен совпадать со статьями из «Главного по рубрикам»
const editorsPick = articles.find((a) => a.rubric === 'move' && a.category === 'zhile' && a.slug === 'kak-iskat-dlitelnuyu-arendu');
const editorsPickTopic = topics.find((t) => t.rubric === editorsPick.rubric && t.slug === editorsPick.category);

// «Главное по рубрикам» — до 8 карточек. Сначала берём конкретные проверенные статьи,
// затем добираем ещё по одной статье из следующих разделов (первая попавшаяся в разделе).
const gridSlugs = [
  { rubric: 'move', category: 'viza', slug: 'vidy-viz' },
  { rubric: 'tourist', category: 'kofe', slug: 'xom-com-coffee' },
  { rubric: 'tourist', category: 'svyaz', slug: 'sim-i-esim-dlya-turista' },
  { rubric: 'tourist', category: 'eda', slug: 'alpaca-restaurant' },
];
const gridExtraCategories = [
  { rubric: 'tourist', category: 'plyazhi' },
  { rubric: 'move', category: 'zhile' },
  { rubric: 'move', category: 'banki' },
  { rubric: 'move', category: 'internet' },
];
const GRID_MAX = 8;

const gridItems = gridSlugs.map((g) => {
  const a = articles.find((x) => x.rubric === g.rubric && x.category === g.category && x.slug === g.slug);
  const t = topics.find((x) => x.rubric === g.rubric && x.slug === g.category);
  return { article: a, topic: t };
}).filter((x) => x.article && x.topic);

const usedKeys = new Set(gridItems.map((x) => `${x.article.rubric}/${x.article.category}/${x.article.slug}`));
usedKeys.add(`${editorsPick.rubric}/${editorsPick.category}/${editorsPick.slug}`);

for (const g of gridExtraCategories) {
  if (gridItems.length >= GRID_MAX) break;
  const a = articles.find((x) => x.rubric === g.rubric && x.category === g.category && !usedKeys.has(`${x.rubric}/${x.category}/${x.slug}`));
  const t = topics.find((x) => x.rubric === g.rubric && x.slug === g.category);
  if (a && t) {
    gridItems.push({ article: a, topic: t });
    usedKeys.add(`${a.rubric}/${a.category}/${a.slug}`);
  }
}

function timeAgo(dateStr) {
  const days = Math.floor((Date.now() - new Date(dateStr).getTime()) / 86400000);
  if (days <= 0) return 'сегодня';
  if (days === 1) return 'вчера';
  if (days < 7) return `${days} дн. назад`;
  const weeks = Math.floor(days / 7);
  return `${weeks} нед. назад`;
}

// Лента "последнее" — 5 штук вперемешку из news/blog/events
const latestFeed = feed.slice(0, 5);
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Приехали — Вьетнам🇻🇳</title>
<meta name="description" content="Всё о жизни в Нячанге в одном месте: для туриста, для переезжающих и для тех, кто уже обжился.">
<meta name="theme-color" content="#F4F6F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#F4F6F0; --bg-card:#FFFFFF; --ink:#16232B; --ink-soft:#4A5A5F; --line:#DAE1D3;
    --jade:#2F7B6D; --jade-dark:#204F46; --gold:#D9A441;
    --serif:"Newsreader",Georgia,serif; --sans:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif; --maxw:1080px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{overflow-x:hidden;max-width:100%}
  img,iframe{max-width:100%}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  button,select{font:inherit;color:inherit}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  :focus-visible{outline:2px solid var(--jade);outline-offset:2px;border-radius:6px}

  .nav__tag{font-size:.85rem;color:var(--ink-soft)}

  .hero{padding:12px 0 48px;text-align:center}
  .hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.8rem,8vw,3.4rem);line-height:1.08;margin:0 auto 16px;max-width:16ch}
  .hero__sub{font-size:1.02rem;color:var(--ink-soft);max-width:46ch;margin:0 auto}

  .ticket{background:var(--bg-card);border:1px solid var(--line);border-radius:18px;padding:22px 22px 26px;box-shadow:0 24px 48px -32px rgba(22,35,43,.35);max-width:680px;margin:36px auto 0}
  .ticket__route{display:flex;align-items:center;justify-content:space-between;font-size:.72rem;letter-spacing:.14em;color:var(--ink-soft);font-weight:600}
  .ticket__plane{color:var(--gold);font-size:.9rem}

  .ticket__tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:18px}
  .ticket__tab{background:transparent;border:1px solid var(--line);border-radius:10px;padding:10px 6px;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;color:var(--ink-soft);transition:border-color .15s ease,color .15s ease,background .15s ease}
  .ticket__tab:hover{border-color:var(--jade)}
  .ticket__tab.active{background:var(--jade);border-color:var(--jade);color:#fff}
  .ticket__code{font-size:.68rem;letter-spacing:.12em;font-weight:600;opacity:.75}
  .ticket__label{font-size:.92rem;font-weight:500}

  .ticket__perf{position:relative;height:1px;margin:20px -22px 18px;background:repeating-linear-gradient(to right,var(--line) 0 6px,transparent 6px 12px)}
  .ticket__perf::before,.ticket__perf::after{content:'';position:absolute;top:50%;width:16px;height:16px;background:var(--bg);border-radius:50%;transform:translateY(-50%)}
  .ticket__perf::before{left:-8px}
  .ticket__perf::after{right:-8px}

  .ticket__lead{margin:0 0 16px;color:var(--ink);font-weight:500;font-size:1.02rem}
  .field{margin-bottom:14px}
  .field__label{display:block;font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:7px}
  .selwrap{position:relative;display:inline-block}
  .selwrap select{appearance:none;-webkit-appearance:none;border:1px solid var(--line);border-radius:999px;background:#fff;font-weight:500;font-size:.9rem;color:var(--ink);padding:8px 30px 8px 15px;cursor:pointer;outline:none}
  .selwrap::after{content:"▾";position:absolute;right:13px;top:50%;transform:translateY(-50%);color:var(--ink-soft);font-size:.72rem;pointer-events:none}
  .chips{display:flex;flex-wrap:wrap;gap:7px}
  .chip{padding:8px 15px;border-radius:999px;border:1px solid var(--line);background:#fff;font-weight:500;font-size:.87rem;color:var(--ink);cursor:pointer;transition:all .15s}
  .chip:hover{border-color:var(--jade)}
  .chip.on{background:var(--jade);border-color:var(--jade);color:#fff}

  .ticket__go{width:100%;border:0;border-radius:12px;background:var(--jade);color:#fff;font-weight:600;font-size:.96rem;padding:13px;margin-top:6px;cursor:pointer;transition:background .15s}
  .ticket__go:hover{background:var(--jade-dark)}

  /* ---- ДЕСКТОП (исходный вид): фиксированный сайдбар погоды/курса ---- */
  .conditions{position:fixed;top:96px;left:28px;display:flex;flex-direction:column;gap:10px;width:200px;z-index:6}
  .cond-card{background:var(--bg-card);border:1px solid var(--line);border-radius:14px;padding:14px 15px;box-shadow:0 16px 32px -26px rgba(22,35,43,.35)}
  .cond-label{display:block;font-size:.64rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:9px}
  .cond-loading{font-size:.8rem;color:var(--ink-soft)}
  .weather-row{display:flex;align-items:center;gap:9px}
  .weather-icon{flex:none}
  .cond-temp{font-family:var(--serif);font-size:1.45rem;font-weight:500;color:var(--ink);line-height:1}
  .cond-desc{font-size:.76rem;color:var(--ink-soft);margin-top:3px}
  .cond-feels{font-size:.68rem;color:var(--ink-soft);margin-top:9px}
  .rate-row{display:flex;align-items:center;justify-content:space-between;padding:4px 0;gap:6px;white-space:nowrap}
  .rate-left{display:flex;align-items:center;gap:6px;min-width:0}
  .rate-coin{width:18px;height:18px;border-radius:50%;color:#fff;font-size:8.5px;font-weight:700;display:flex;align-items:center;justify-content:center;flex:none}
  .rate-label{font-size:.72rem;color:var(--ink)}
  .rate-value{font-size:.72rem;font-weight:600;color:var(--ink)}
  .cond-error{font-size:.76rem;color:var(--ink-soft)}

  /* ---- ДЕСКТОП (исходный вид): сетка "Главное по рубрикам" 4 колонки ---- */
  .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .gcard{display:block;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s}
  .gcard:hover{transform:translateY(-3px);border-color:var(--jade);box-shadow:0 20px 40px -28px rgba(22,35,43,.4)}
  .gcard__photo{height:110px;background:repeating-linear-gradient(135deg,var(--line) 0 10px,transparent 10px 20px);display:flex;align-items:center;justify-content:center;font-size:1.6rem}
  .gcard__photo--real{width:100%;height:110px;object-fit:cover;object-position:top;display:block}
  .gcard__body{padding:14px 16px 16px}
  .gcard__tag{display:inline-block;font-size:.62rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--jade-dark);margin-bottom:6px}
  .gcard h3{font-size:.94rem;font-weight:600;line-height:1.3;margin-bottom:6px}
  .gcard__time{font-size:.72rem;color:var(--ink-soft)}

  /* ---- МОБИЛЬНАЯ версия (<=700px): горизонтальная лента "Главное по рубрикам" ---- */
  .gridstrip-head{display:none;max-width:var(--maxw);margin:0 auto;padding:8px 24px 4px}
  .gridstrip-head h2{font-family:var(--serif);font-weight:500;font-size:.94rem}
  .gridstrip{display:none;gap:8px;overflow-x:auto;padding:2px 24px 8px;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .gridstrip::-webkit-scrollbar{display:none}
  .gscard{flex:0 0 100px;scroll-snap-align:start;display:block;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s}
  .gscard:hover{transform:translateY(-2px);border-color:var(--jade);box-shadow:0 14px 28px -22px rgba(22,35,43,.4)}
  .gscard__photo{height:38px;background:repeating-linear-gradient(135deg,var(--line) 0 10px,transparent 10px 20px);display:flex;align-items:center;justify-content:center;font-size:1.1rem}
  .gscard__photo--real{width:100%;height:38px;object-fit:cover;object-position:top;display:block}
  .gscard__body{padding:6px 7px 8px}
  .gscard__tag{display:block;font-size:.52rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--jade-dark);margin-bottom:2px}
  .gscard h3{font-size:.68rem;font-weight:600;line-height:1.2;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

  @media (max-width:1180px){
    .conditions{position:static;flex-direction:row;width:100%;max-width:460px;margin:14px auto 0}
  }
  @media (max-width:560px){
    .conditions{flex-direction:column}
  }
  /* переключение десктоп/мобильная версия шапки на 700px */
  @media (max-width:700px){
    .conditions{display:none}
    .desktop-grid{display:none}
    .gridstrip-head{display:block;padding:0 24px 4px}
    .gridstrip{display:flex}
    .breaking{padding:8px 20px;margin:0 auto 10px}
    .hero{padding:4px 0 28px}
    .hero h1{margin:0 auto 14px}
    .hero__sub{font-size:clamp(.72rem,3.6vw,.95rem);white-space:nowrap;max-width:100%}
    .ticket{margin:14px auto 0}
  }

  .picks{padding:56px 0 40px}
  .picks-head{text-align:center;margin-bottom:30px}
  .picks-head h2{font-family:var(--serif);font-weight:500;font-size:clamp(1.5rem,3vw,2rem)}
  .picks-head p{color:var(--ink-soft);margin-top:6px}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
  .card{position:relative;background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;transition:transform .2s,box-shadow .2s,border-color .2s;color:inherit;display:block}
  .card:hover{transform:translateY(-3px);border-color:var(--jade);box-shadow:0 20px 40px -30px rgba(22,35,43,.4)}
  .card.feat{background:linear-gradient(150deg,rgba(217,164,65,.14),rgba(47,123,109,.08));border-color:var(--gold)}
  .card .ic{font-size:1.5rem}
  .card h3{font-weight:600;font-size:1.05rem;margin:12px 0 4px}
  .card p{color:var(--ink-soft);font-size:.86rem;margin-bottom:12px}
  .card .go{font-size:.72rem;letter-spacing:.04em;color:var(--jade-dark);font-weight:600}
  .card .soon{font-size:.68rem;letter-spacing:.04em;color:var(--ink-soft);border:1px solid var(--line);border-radius:99px;padding:3px 9px}
  .favbtn{position:absolute;top:14px;right:14px;width:30px;height:30px;border:1px solid var(--line);border-radius:50%;background:#fff;font-size:.95rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);transition:all .15s}
  .favbtn:hover{border-color:var(--gold)}
  .favbtn.on{color:var(--gold);border-color:var(--gold);background:rgba(217,164,65,.1)}

  /* ---- МОБИЛЬНАЯ версия (<=700px): подборки по 2 карточки в ряд ---- */
  @media (max-width:700px){
    .cards{grid-template-columns:repeat(2,1fr);gap:9px}
    .card{border-radius:12px;padding:12px}
    .card .ic{font-size:1.2rem}
    .card h3{font-size:.84rem;margin:8px 0 3px;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .card p{font-size:.72rem;line-height:1.3;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .card .go{font-size:.66rem}
    .card .soon{font-size:.62rem;padding:2px 7px}
    .favbtn{top:9px;right:9px;width:26px;height:26px;font-size:.82rem}
  }

  .breaking{display:flex;align-items:center;gap:10px;max-width:1080px;margin:0 auto 18px;padding:11px 24px;background:linear-gradient(120deg,rgba(217,164,65,.14),rgba(47,123,109,.1));border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:.86rem}
  .breaking__tag{flex:none;font-size:.64rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--jade-dark);background:#fff;border-radius:999px;padding:3px 10px}
  .breaking__text{flex:1;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .breaking__arrow{flex:none;color:var(--jade-dark);font-weight:600}
  .breaking:hover .breaking__text{text-decoration:underline}

  .section{padding:44px 0}
  .section__head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:22px}
  .section__head h2{font-family:var(--serif);font-weight:500;font-size:1.5rem}
  .section__head a{font-size:.8rem;color:var(--jade-dark);font-weight:600}

  .split{display:grid;grid-template-columns:1.1fr 1fr;gap:28px}
  .latest-list{display:flex;flex-direction:column}
  .litem{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-bottom:1px solid var(--line)}
  .litem:first-child{padding-top:0}
  .litem__ph{flex:none;width:64px;height:64px;border-radius:10px;background:repeating-linear-gradient(135deg,var(--line) 0 8px,transparent 8px 16px);display:flex;align-items:center;justify-content:center;font-size:1.2rem}
  .litem__kind{font-size:.62rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--jade-dark);margin-bottom:3px}
  .litem h3{font-size:.9rem;font-weight:600;line-height:1.3;margin-bottom:3px}
  .litem__time{font-size:.72rem;color:var(--ink-soft)}

  .pick{display:block;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;height:100%;transition:transform .2s,box-shadow .2s,border-color .2s}
  .pick:hover{transform:translateY(-3px);border-color:var(--jade);box-shadow:0 24px 48px -30px rgba(22,35,43,.4)}
  .pick__photo{height:170px;background:repeating-linear-gradient(135deg,var(--line) 0 10px,transparent 10px 20px);display:flex;align-items:center;justify-content:center;font-size:2rem}
  .pick__photo--real{width:100%;height:200px;object-fit:cover;display:block}
  .pick__body{padding:20px 22px 24px}
  .pick__tag{display:inline-block;font-size:.66rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}
  .pick h3{font-family:var(--serif);font-weight:500;font-size:1.3rem;line-height:1.2;margin-bottom:8px}
  .pick p{color:var(--ink-soft);font-size:.9rem;margin-bottom:14px}
  .pick__cta{font-size:.84rem;font-weight:600;color:var(--jade-dark)}

  .footer2{border-top:1px solid var(--line);padding:36px 0 24px}
  .footer2__top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px;margin-bottom:24px}
  .footer2__brand{font-family:var(--serif);font-size:1.2rem;color:var(--jade-dark)}
  .footer2__tag{font-size:.82rem;color:var(--ink-soft);margin-top:4px;max-width:32ch}
  .footer2__links{display:flex;gap:32px;flex-wrap:wrap}
  .footer2__col h4{font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:10px}
  .footer2__col a{display:block;font-size:.86rem;color:var(--ink);padding:3px 0}
  .footer2__col a:hover{color:var(--jade-dark)}
  .footer2__bottom{border-top:1px solid var(--line);padding-top:18px;font-size:.78rem;color:var(--ink-soft)}

  @media (max-width:900px){
    .split{grid-template-columns:1fr}
    .grid4{grid-template-columns:repeat(2,1fr)}
  }
  @media (max-width:1180px){
    .breaking{max-width:none}
  }

  .author{padding:40px 0;border-top:1px solid var(--line)}
  .author__row{display:flex;align-items:flex-start;gap:20px;max-width:720px;margin:0 auto}
  .author__row > div{min-width:0}
  .author svg{width:38px;height:20px;color:var(--gold);flex:none;margin-top:4px}
  .author__title{display:block;color:var(--ink);font-family:var(--serif);font-weight:600;font-size:1.02rem;margin-bottom:6px}
  .author p{color:var(--ink-soft);font-size:.92rem}
  .author a{color:var(--jade-dark);font-weight:600}

  footer{padding:24px 0 40px;border-top:1px solid var(--line)}
  .footer__row{display:flex;justify-content:space-between;max-width:var(--maxw);margin:0 auto;padding:0 24px;font-family:var(--serif);color:var(--jade-dark)}
  .footer__muted{font-family:var(--sans);color:var(--ink-soft);font-size:.85rem}

  @media (max-width:600px){
    .author__row{flex-direction:column;text-align:center}
  }
</style>
</head>
<body>
<SiteHeader />

<a class="breaking" href={breaking.href}>
  <span class="breaking__tag">Свежее</span>
  <span class="breaking__text">{breaking.title}</span>
  <span class="breaking__arrow">→</span>
</a>

<!-- ДЕСКТОП: исходный сайдбар с погодой/курсом -->
<div class="conditions" id="conditions">
  <div class="cond-card">
    <span class="cond-label">Нячанг сейчас</span>
    <div class="cond-body weatherBody">
      <span class="cond-loading">Гружу погоду…</span>
    </div>
  </div>
  <div class="cond-card">
    <span class="cond-label">Курс валют</span>
    <div class="cond-body ratesBody">
      <span class="cond-loading">Гружу курс…</span>
    </div>
  </div>
</div>

<!-- МОБИЛЬНАЯ ВЕРСИЯ: горизонтальная лента "Главное по рубрикам" наверху -->
<div class="gridstrip-head"><h2>Главное по рубрикам</h2></div>
<div class="gridstrip">
  {gridItems.map(({ article, topic }) => (
    <a class="gscard" href={`/${article.rubric}/${article.category}/${article.slug}/`}>
      {article.images && article.images.length > 0 ? (
        <picture>
          <source srcset={article.images[0].replace('.jpg', '.webp')} type="image/webp" />
          <img class="gscard__photo gscard__photo--real" src={article.images[0]} alt={article.title} loading="lazy" />
        </picture>
      ) : (
        <div class="gscard__photo">{article.icon}</div>
      )}
      <div class="gscard__body">
        <span class="gscard__tag">{topic.title}</span>
        <h3>{article.title}</h3>
      </div>
    </a>
  ))}
</div>

