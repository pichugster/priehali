<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>приехали. — Нячанг, каким я его знаю</title>
<meta name="description" content="Живу в Нячанге и рассказываю как есть. Выбери, кто ты — турист, переезжаешь или ищешь доход, который долетит с тобой — получи подборку под себя.">
<meta name="theme-color" content="#FFFCF9">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#FFFCF9; --ink:#141A2A; --muted:#6B7382; --line:#EFE7DF; --surface:#ffffff;
    --coral:#FF7E6B; --amber:#FF9E64; --pink:#FB7BA2;
    --sun:linear-gradient(120deg,#FFB25E 0%,#FF7E6B 55%,#FB7BA2 100%);
    --display:"Quicksand",system-ui,sans-serif; --body:"Inter",system-ui,sans-serif; --maxw:1120px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--body);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  button,select{font:inherit;color:inherit}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
  .grad{background:var(--sun);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  :focus-visible{outline:2px solid var(--coral);outline-offset:2px;border-radius:8px}
  .sky-glow{position:fixed;inset:0;z-index:0;pointer-events:none;
    background:radial-gradient(70% 50% at 50% -10%,rgba(255,158,100,.24),transparent 62%)}

  nav{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:20px 22px;max-width:var(--maxw);margin:0 auto}
  .brand{display:flex;align-items:center;gap:9px;font-family:var(--display);font-weight:700;font-size:1.2rem}
  .brand svg{width:26px;height:14px;color:var(--coral)}
  .nav-right{font-family:ui-monospace,monospace;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}

  main{position:relative;z-index:5}
  .hero{max-width:var(--maxw);margin:0 auto;padding:clamp(20px,5vh,54px) 22px 20px;text-align:center}
  .eyebrow{font-family:ui-monospace,monospace;font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;color:var(--coral)}
  .hero h1{font-family:var(--display);font-weight:700;font-size:clamp(2.1rem,5vw,3.5rem);line-height:1.08;letter-spacing:-.02em;margin:16px auto 14px;max-width:20ch}
  .hero .lede{color:var(--muted);font-size:clamp(1rem,1.5vw,1.12rem);max-width:46ch;margin:0 auto}

  .search{max-width:940px;margin:34px auto 0}
  .tabs{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:16px}
  .tab{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:999px;border:1px solid var(--line);background:#fff;font-family:var(--display);font-weight:600;font-size:.95rem;color:var(--muted);cursor:pointer;transition:all .22s;box-shadow:0 6px 18px -14px rgba(20,26,42,.4)}
  .tab:hover{color:var(--ink)}
  .tab.active{color:#fff;background:var(--sun);border-color:transparent;box-shadow:0 14px 30px -14px rgba(255,126,107,.7)}

  .widget{background:#fff;border:1px solid var(--line);border-radius:22px;padding:16px;box-shadow:0 30px 60px -34px rgba(20,26,42,.4)}
  .fields[hidden]{display:none}
  .row{display:flex;flex-wrap:wrap;gap:6px 8px;align-items:center}
  .row + .row{margin-top:12px}
  .rowlabel{flex:none;font-size:.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);width:100%;text-align:left;margin-bottom:2px}
  .chip{display:inline-flex;align-items:center;padding:8px 15px;border-radius:999px;border:1px solid var(--line);background:#fff;font-family:var(--display);font-weight:600;font-size:.86rem;color:var(--ink);cursor:pointer;transition:all .18s}
  .chip:hover{border-color:var(--coral)}
  .chip.on{background:linear-gradient(120deg,rgba(255,178,94,.16),rgba(251,123,162,.16));border-color:var(--coral);color:var(--coral)}
  .selwrap{position:relative;flex:none}
  .selwrap select{appearance:none;-webkit-appearance:none;border:1px solid var(--line);border-radius:999px;background:#fff;font-family:var(--display);font-weight:600;font-size:.86rem;color:var(--ink);padding:8px 30px 8px 15px;cursor:pointer;outline:none}
  .selwrap::after{content:"▾";position:absolute;right:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:.75rem;pointer-events:none}
  .wbtn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:16px;background:var(--sun);color:#fff;font-family:var(--display);font-weight:700;font-size:1rem;padding:13px 26px;margin-top:14px;cursor:pointer;transition:transform .2s;box-shadow:0 14px 30px -12px rgba(255,126,107,.75)}
  .wbtn:hover{transform:translateY(-2px)}

  .picks{position:relative;z-index:5;padding:56px 0 40px}
  .picks-head{text-align:center;margin-bottom:30px}
  .picks-head h2{font-family:var(--display);font-weight:700;font-size:clamp(1.5rem,3vw,2.1rem);letter-spacing:-.01em}
  .picks-head p{color:var(--muted);margin-top:6px}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
  .card{position:relative;display:block;background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;transition:transform .25s,box-shadow .25s,border-color .25s;color:inherit;box-shadow:0 12px 30px -24px rgba(20,26,42,.5)}
  .card:hover{transform:translateY(-4px);border-color:#f3d9c9;box-shadow:0 26px 46px -28px rgba(255,126,107,.5)}
  .card.feat{background:linear-gradient(150deg,rgba(255,158,100,.16),rgba(251,123,162,.12));border-color:#f6cbb3}
  .card .ic{font-size:1.6rem}
  .card h3{font-family:var(--display);font-weight:600;font-size:1.08rem;margin:12px 0 4px}
  .card p{color:var(--muted);font-size:.86rem;margin-bottom:12px}
  .card .go{font-family:ui-monospace,monospace;font-size:.64rem;letter-spacing:.1em;text-transform:uppercase;color:var(--coral);font-weight:700}
  .card .soon{font-family:ui-monospace,monospace;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:99px;padding:3px 9px}

  .author{position:relative;z-index:5;border-top:1px solid var(--line);padding:40px 0}
  .author .wrap{display:flex;align-items:center;gap:20px;max-width:760px}
  .author svg{width:40px;height:22px;color:var(--coral);flex:none}
  .author p{color:var(--muted);font-size:.92rem}
  .author p b{color:var(--ink);font-family:var(--display);font-weight:600}
  .author a{color:var(--coral);font-weight:600}

  footer{position:relative;z-index:5;border-top:1px solid var(--line);padding:30px 22px;text-align:center;color:var(--muted);font-family:ui-monospace,monospace;font-size:.7rem;letter-spacing:.1em}

  @media (max-width:760px){
    .widget{border-radius:20px}
    .author .wrap{flex-direction:column;text-align:center}
  }
</style>
</head>
<body>
<div class="sky-glow"></div>
<nav>
  <a class="brand" href="/">
    <svg viewBox="0 0 48 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 18C10 6 18 6 24 14C30 6 38 6 46 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
    приехали.
  </a>
  <div class="nav-right">Нячанг · Вьетнам</div>
</nav>
<main>
  <section class="hero">
    <span class="eyebrow">the sky has no borders</span>
    <h1>Ну что, <span class="grad">приехали?</span></h1>
    <p class="lede">Живу в Нячанге, а не продаю мечту о нём. Выбери, кто ты — соберём то, что реально пригодится.</p>
    <div class="search">
      <div class="tabs">
        <button class="tab active" data-tab="tourist">🏖 Туристу</button>
        <button class="tab" data-tab="move">✈️ Переезд</button>
        <button class="tab" data-tab="earn">💻 Удалёнка</button>
      </div>

      <div class="widget">
        <div class="fields" data-fields="tourist">
          <div class="row">
            <span class="rowlabel">Ты в Нячанге</span>
            <div class="selwrap"><select id="t_exp"><option value="first">Впервые</option><option value="been">Уже был</option></select></div>
          </div>
          <div class="row" id="t_int_row">
            <span class="rowlabel">Что интересно (можно несколько)</span>
            <button class="chip on" data-group="t_int" data-value="all">Всё подряд</button>
            <button class="chip" data-group="t_int" data-value="food">Еда</button>
            <button class="chip" data-group="t_int" data-value="beach">Пляжи</button>
            <button class="chip" data-group="t_int" data-value="party">Тусовки</button>
            <button class="chip" data-group="t_int" data-value="tours">Экскурсии</button>
          </div>
        </div>

        <div class="fields" data-fields="move" hidden>
          <div class="row">
            <span class="rowlabel">Едешь</span>
            <div class="selwrap"><select id="m_inc"><option value="income">С доходом</option><option value="savings">С накоплениями</option><option value="none">Без дохода</option></select></div>
          </div>
          <div class="row" id="m_comp_row">
            <span class="rowlabel">Состав (можно несколько)</span>
            <button class="chip on" data-group="m_comp" data-value="solo">Один</button>
            <button class="chip" data-group="m_comp" data-value="couple">Парой</button>
            <button class="chip" data-group="m_comp" data-value="family">С детьми</button>
            <button class="chip" data-group="m_comp" data-value="pet">С питомцем</button>
          </div>
        </div>

        <div class="fields" data-fields="earn" hidden>
          <div class="row">
            <span class="rowlabel">Направление</span>
            <div class="selwrap"><select id="e_dir"><option value="all">Все способы</option><option value="ai">Нейросети</option><option value="montage">Монтаж</option><option value="content">Контент</option></select></div>
            <span class="rowlabel" style="width:auto;margin:0 0 0 8px">Уровень</span>
            <div class="selwrap"><select id="e_lvl"><option value="zero">С нуля</option><option value="some">Уже что-то умею</option></select></div>
          </div>
        </div>

        <button class="wbtn" id="go">Показать подборку</button>
      </div>
    </div>
  </section>

  <section class="picks" id="picks">
    <div class="wrap">
      <div class="picks-head"><h2 id="picksTitle">Подборки для туриста</h2><p id="picksSub">Проверено на месте — тыкай в категорию</p></div>
      <div class="cards" id="cards"></div>
    </div>
  </section>
</main>

<section class="author">
  <div class="wrap">
    <svg viewBox="0 0 48 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 18C10 6 18 6 24 14C30 6 38 6 46 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
    <p><b>Никита.</b> Переехал в Нячанг и рассказываю изнутри — без розовых очков и без инфоцыганства. Отдельно веду <a href="https://pichugster.com">pichugster.com</a> — про доход, который можно увезти с собой.</p>
  </div>
</section>

<footer>© 2026 приехали. · the sky has no borders</footer>

<script is:inline>
  let activeTab='tourist';
  const tabs=document.querySelectorAll('.tab'), fieldsets=document.querySelectorAll('.fields');
  const cardsEl=document.getElementById('cards'), titleEl=document.getElementById('picksTitle'), subEl=document.getElementById('picksSub');

  const multi={ t_int:new Set(['all']), m_comp:new Set(['solo']) };

  document.querySelectorAll('.chip').forEach(chip=>{
    chip.addEventListener('click',()=>{
      const group=chip.dataset.group, value=chip.dataset.value, set=multi[group];
      const groupChips=[...document.querySelectorAll(`.chip[data-group="${group}"]`)];
      const resetValue = group==='t_int' ? 'all' : 'solo';

      if(value===resetValue){
        set.clear(); set.add(resetValue);
      } else {
        set.delete(resetValue);
        if(set.has(value)) set.delete(value); else set.add(value);
        if(set.size===0) set.add(resetValue);
      }
      groupChips.forEach(c=>c.classList.toggle('on', set.has(c.dataset.value)));
      render();
    });
  });

  function card(ic,t,d,href){ if(href) return `<a class="card" href="${href}"><div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="go">Открыть →</span></a>`; return `<div class="card"><div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="soon">Скоро</span></div>`; }
  function val(id,def){ const el=document.getElementById(id); return el?el.value:def; }

  const touristCards=[
    {ic:'🍜',t:'Где поесть',d:'Кафе, стритфуд, рестораны',tag:'food'},
    {ic:'🏖',t:'Пляжные клубы',d:'Где провести день у моря',tag:'beach'},
    {ic:'🎉',t:'Тусовки',d:'Бары и вечеринки',tag:'party'},
    {ic:'🗺',t:'Экскурсии',d:'Острова, водопады, туры',tag:'tours'},
    {ic:'💆',t:'Массажи и спа',d:'Проверенные места',tag:null},
    {ic:'🛵',t:'Аренда байка',d:'Где брать и как не влететь',tag:null},
    {ic:'🏨',t:'Где остановиться',d:'Районы и отели',tag:null},
    {ic:'💸',t:'Цены',d:'Сколько брать с собой и как считать',tag:null},
  ];

  function render(){
    let title='',sub='',cards=[];
    if(activeTab==='tourist'){
      title='Подборки для туриста';
      sub=val('t_exp','first')==='first'?'Впервые в Нячанге — вот с чего начать':'Ты уже был — копнём глубже';
      const chosen=multi.t_int;
      const showAll=chosen.has('all');
      cards=touristCards.filter(c=>c.tag===null || showAll || chosen.has(c.tag)).map(c=>card(c.ic,c.t,c.d));
    } else if(activeTab==='move'){
      const incVal=val('m_inc','income');
      const inc={income:'С доходом',savings:'С накоплениями',none:'Без дохода'}[incVal];
      const comp=multi.m_comp;
      const compLabels={solo:'один',couple:'парой',family:'с детьми',pet:'с питомцем'};
      title='Переезд в Нячанг';
      sub=inc+' · '+[...comp].map(v=>compLabels[v]).join(', ');
      if(incVal==='none') cards.push(card('🧑‍💻','Научиться зарабатывать','Удалённый доход с нуля — на pichugster','https://pichugster.com').replace('class="card"','class="card feat"'));
      cards.push(card('🛂','Виза','Как въехать и продлевать'),card('🏠','Жильё надолго','Районы, цены, договоры'),card('🏦','Банки и деньги','Карты и как платить'),card('📶','Симка и интернет','Связь с первого дня'),card('🛵','Транспорт','Байк, права, аренда'),card('🩺','Медицина','Клиники и страховка'),card('💸','Сколько нужно денег','Стартовый бюджет и как считать'),card('🤝','Комьюнити','Где найти своих'));
      if(comp.has('family')) cards.push(card('🎒','Школы и садики','Куда устроить детей'));
      if(comp.has('pet')) cards.push(card('🐾','Ввоз питомца','Документы и жильё'));
      if(comp.has('couple')) cards.push(card('👫','Жильё для двоих','Совместный бюджет'));
      if(comp.has('solo') && comp.size===1) cards.push(card('🧳','Коливинги','Как не заскучать и найти своих'));
    } else {
      title='Удалённый доход'; sub=val('e_lvl','zero')==='zero'?'С нуля — старт для новичка':'Уже умеешь — прокачаем';
      cards=[card('🤖','Заработок на ИИ','Услуги, контент, продукты','https://pichugster.com'),card('🎬','Монтаж','Навык, который кормит','https://pichugster.com'),card('✍️','Контент и тексты','На заказ и для себя','https://pichugster.com'),card('🧭','С чего начать','Первые шаги новичку','https://pichugster.com')];
    }
    titleEl.textContent=title; subEl.textContent=sub; cardsEl.innerHTML=cards.join('');
  }

  tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>x.classList.remove('active'));t.classList.add('active');activeTab=t.dataset.tab;fieldsets.forEach(f=>f.hidden=f.dataset.fields!==activeTab);render();}));
  document.querySelectorAll('.fields select').forEach(s=>s.addEventListener('change',render));
  document.getElementById('go').addEventListener('click',()=>{render();document.getElementById('picks').scrollIntoView({behavior:'smooth',block:'start'});});
  render();
</script>
</body>
</html>
