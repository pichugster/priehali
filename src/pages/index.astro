---
import Layout from '../layouts/Layout.astro';

const tabs = [
  {
    code: 'TUR',
    label: 'Турист',
    lead: 'Едешь на пару недель — не на постоянку.',
    points: [
      'Куда ехать в первый раз и куда во второй',
      'Аренда байка, жильё, где не обманут с ценой',
      'Готовые маршруты на 7 и 14 дней',
    ],
  },
  {
    code: 'MOV',
    label: 'Переезд',
    lead: 'Собираешься остаться надолго — с вещами, документами и вопросами.',
    points: [
      'Визы, аренда жилья, первые недели на месте',
      'Сколько реально нужно денег на старт',
      'Чек-листы: что сделать до вылета',
    ],
  },
  {
    code: 'WRK',
    label: 'Удалёнка',
    lead: 'Нужен доход, который долетит вместе с тобой.',
    points: [
      'Разбор способов удалённого заработка',
      'С чего начать, если опыта в онлайне нет',
      'Личный опыт — не курс, а рабочий путь',
    ],
  },
];
---

<Layout title="Приехали — Вьетнам без розовых очков">
  <header class="nav">
    <div class="wrap nav__row">
      <span class="nav__logo">приехали.</span>
      <span class="nav__tag">Вьетнам без розовых очков</span>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero__row">
        <div class="hero__text">
          <h1>Небо не делит<br />на страны.</h1>
          <p class="hero__sub">
            Гид по Вьетнаму для тех, кто летит туристом, переезжает насовсем
            или строит доход, который можно увезти с собой.
          </p>
        </div>

        <div class="ticket" id="ticket">
          <div class="ticket__route">
            <span>PRIEHALI</span>
            <span class="ticket__plane" aria-hidden="true">✈</span>
            <span>NHA TRANG</span>
          </div>

          <div class="ticket__tabs" role="tablist" aria-label="Выбери, зачем ты здесь">
            {tabs.map((t, i) => (
              <button
                class="ticket__tab"
                data-tab={t.code}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                type="button"
              >
                <span class="ticket__code">{t.code}</span>
                <span class="ticket__label">{t.label}</span>
              </button>
            ))}
          </div>

          <div class="ticket__perf" aria-hidden="true"></div>

          <div class="ticket__panels">
            {tabs.map((t, i) => (
              <div class="ticket__panel" data-panel={t.code} hidden={i !== 0}>
                <p class="ticket__lead">{t.lead}</p>
                <ul class="ticket__points">
                  {t.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="status">
      <div class="wrap">
        <p>Сайт только взлетает — разделы наполняются. Первым делом появится «Переезд».</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__row">
      <span>приехали.</span>
      <span class="footer__muted">© {new Date().getFullYear()}</span>
    </div>
  </footer>
</Layout>

<style>
  .nav {
    padding: 28px 0;
  }
  .nav__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .nav__logo {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--jade-dark);
  }
  .nav__tag {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .hero {
    padding: 20px 0 64px;
  }
  .hero__row {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: start;
  }
  .hero__text h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    margin: 8px 0 24px;
    color: var(--ink);
  }
  .hero__sub {
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 42ch;
    margin: 0;
  }

  /* Boarding pass card */
  .ticket {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px 22px 26px;
    box-shadow: 0 24px 48px -32px rgba(22, 35, 43, 0.35);
  }
  .ticket__route {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .ticket__plane {
    color: var(--gold);
    font-size: 0.9rem;
  }

  .ticket__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 18px;
  }
  .ticket__tab {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    cursor: pointer;
    font-family: var(--sans);
    color: var(--ink-soft);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .ticket__tab:hover {
    border-color: var(--jade);
  }
  .ticket__tab[aria-selected='true'] {
    background: var(--jade);
    border-color: var(--jade);
    color: #fff;
  }
  .ticket__code {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    font-weight: 600;
    opacity: 0.75;
  }
  .ticket__label {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .ticket__perf {
    position: relative;
    height: 1px;
    margin: 20px -22px 18px;
    background: repeating-linear-gradient(
      to right,
      var(--line) 0 6px,
      transparent 6px 12px
    );
  }
  .ticket__perf::before,
  .ticket__perf::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 16px;
    height: 16px;
    background: var(--bg);
    border-radius: 50%;
    transform: translateY(-50%);
  }
  .ticket__perf::before { left: -8px; }
  .ticket__perf::after { right: -8px; }

  .ticket__lead {
    margin: 0 0 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .ticket__points {
    margin: 0;
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 0.94rem;
    display: grid;
    gap: 8px;
  }

  .status {
    padding: 18px 0 56px;
    border-top: 1px solid var(--line);
  }
  .status p {
    margin: 24px 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .footer {
    padding: 24px 0 40px;
  }
  .footer__row {
    display: flex;
    justify-content: space-between;
    font-family: var(--serif);
    color: var(--jade-dark);
  }
  .footer__muted {
    font-family: var(--sans);
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  @media (max-width: 820px) {
    .hero__row {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.ticket__tab');
  const panels = document.querySelectorAll('.ticket__panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
      tab.setAttribute('aria-selected', 'true');

      panels.forEach((p) => {
        p.hidden = p.getAttribute('data-panel') !== target;
      });
    });
  });
</script>
