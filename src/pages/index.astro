</section>

<footer class="footer2">
  <div class="wrap">
    <div class="footer2__top">
      <div>
        <div class="footer2__brand">приехали.ком</div>
      </div>
      <div class="footer2__links">
        <div class="footer2__col">
          <h4>Разделы</h4>
          <a href="/blog/">Блог</a>
          <a href="/news/">Новости</a>
          <a href="/events/">События</a>
