---
import topics from '../../data/topics.js';
import articles from '../../data/articles.js';

export function getStaticPaths() {
  return topics.map((t) => ({
    params: { rubric: t.rubric, slug: t.slug },
    props: {
      topic: t,
      catArticles: articles.filter((a) => a.rubric === t.rubric && a.category === t.slug),
    },
  }));
}

const { topic, catArticles } = Astro.props;
const siblings = topics.filter((t) => t.rubric === topic.rubric && t.slug !== topic.slug);
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{topic.title} — приехали.ком</title>
<meta name="description" content={topic.summary}>
<meta name="theme-color" content="#F4F6F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<script nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
  (function () {
      var script = document.createElement("script");
      script.async = 1;
      script.setAttribute("data-cmp-ab","2");
      script.src = 'https://emrldtp.com/NTc0NDU3.js?t=574457';
      document.head.appendChild(script);
  })();
</script>
<style is:global>
  :root{
    --bg:#F4F6F0; --bg-card:#FFFFFF; --ink:#16232B; --ink-soft:#4A5A5F; --line:#DAE1D3;
    --jade:#2F7B6D; --jade-dark:#204F46; --gold:#D9A441;
    --serif:"Newsreader",Georgia,serif; --sans:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif; --maxw:1000px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  :focus-visible{outline:2px solid var(--jade);outline-offset:2px;border-radius:6px}

  nav{padding:28px 0}
  .nav__row{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .nav__logo{font-family:var(--serif);font-size:1.3rem;font-weight:500;color:var(--jade-dark)}
  .nav__links{display:flex;gap:16px;font-size:.85rem;color:var(--ink-soft);flex-wrap:wrap}
  .nav__links a:hover{color:var(--jade-dark)}
  .nav__tag{font-size:.85rem;color:var(--ink-soft)}

  .crumbs{padding:6px 0 22px;font-size:.82rem;color:var(--ink-soft)}
  .crumbs a{color:var(--jade-dark);font-weight:500}
  .crumbs a:hover{text-decoration:underline}

  .cat-head{padding-bottom:30px}
  .cat-ic{font-size:2.2rem}
  h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.9rem,4vw,2.6rem);line-height:1.1;margin:10px 0 8px}
  .lede{font-size:1.05rem;color:var(--ink-soft)}

  main{padding-bottom:56px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
  .acard{position:relative;display:block;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s}
  .acard:hover{transform:translateY(-3px);border-color:var(--jade);box-shadow:0 20px 40px -28px rgba(22,35,43,.4)}
  .acard__photo{height:120px;background:repeating-linear-gradient(135deg,var(--line) 0 10px,transparent 10px 20px);display:flex;align-items:center;justify-content:center;font-size:1.8rem}
  .acard__body{padding:16px}
  .acard h3{font-weight:600;font-size:1rem;margin-bottom:6px;line-height:1.3}
  .acard p{color:var(--ink-soft);font-size:.85rem;margin-bottom:10px}
  .acard .go{font-size:.72rem;letter-spacing:.04em;color:var(--jade-dark);font-weight:600}
  .favbtn{position:absolute;top:10px;right:10px;width:30px;height:30px;border:1px solid var(--line);border-radius:50%;background:#fff;font-size:.95rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);transition:all .15s;z-index:2}
  .favbtn:hover{border-color:var(--gold)}
  .favbtn.on{color:var(--gold);border-color:var(--gold);background:rgba(217,164,65,.1)}

  .edit-note{margin-top:32px;padding:16px 18px;border:1px dashed var(--gold);border-radius:14px;background:rgba(217,164,65,.08);font-size:.86rem;color:var(--ink-soft)}
  .edit-note b{color:var(--ink)}

  .siblings{margin-top:48px;border-top:1px solid var(--line);padding-top:28px}
  .siblings h3{font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:14px}
  .sib-list{display:flex;flex-wrap:wrap;gap:8px}
  .sib{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;font-size:.86rem;color:var(--ink);transition:border-color .15s}
  .sib:hover{border-color:var(--jade)}

  footer{padding:24px 0 40px;border-top:1px solid var(--line)}
  .footer__row{display:flex;justify-content:space-between;max-width:var(--maxw);margin:0 auto;padding:0 24px;font-family:var(--serif);color:var(--jade-dark)}
  .footer__muted{font-family:var(--sans);color:var(--ink-soft);font-size:.85rem}
</style>
</head>
<body>
<nav>
  <div class="nav__row">
    <a class="nav__logo" href="/">приехали.ком</a>
    <div class="nav__links">
      <a href="/blog/">Блог</a>
      <a href="/news/">Новости</a>
      <a href="/events/">События</a>
      <a href="/qa/">Вопрос-ответ</a>
      <a href="/favorites/">♡ Избранное</a>
    </div>
  </div>
</nav>

<div class="wrap crumbs">
  <a href="/">приехали.</a> / <a href={`/#${topic.rubric}`}>{topic.rubricLabel}</a> / {topic.title}
</div>

<main class="wrap">
  <div class="cat-head">
    <div class="cat-ic">{topic.icon}</div>
    <h1>{topic.title}</h1>
    <p class="lede">{topic.summary}. Ниже — статьи по теме.</p>
  </div>

  <div class="grid">
    {catArticles.map((a) => {
      const url = `/${a.rubric}/${a.category}/${a.slug}/`;
      return (
      <a class="acard" href={url}>
        <button class="favbtn" data-url={url} data-title={a.title} data-icon={a.icon} onclick="event.preventDefault();event.stopPropagation();toggleFav(this)" aria-label="В избранное">♡</button>
        <div class="acard__photo">{a.icon}</div>
        <div class="acard__body">
          <h3>{a.title}</h3>
          <p>{a.summary}</p>
          <span class="go">Читать →</span>
        </div>
      </a>
      );
    })}
  </div>

  <div class="edit-note">
    <b>Это рыба.</b> Статьи в этой теме генерируются из <code>src/data/articles.js</code>.
    Добавишь туда новый объект с <code>rubric</code>/<code>category</code>, совпадающими с этой темой, —
    появится ещё одна карточка. Поменяешь <code>title</code>/<code>summary</code> у существующей — обновится здесь и в самой статье.
  </div>

  <div class="siblings">
    <h3>Другие темы «{topic.rubricLabel}»</h3>
    <div class="sib-list">
      {siblings.map((s) => (
        <a class="sib" href={`/${s.rubric}/${s.slug}/`}>{s.icon} {s.title}</a>
      ))}
    </div>
  </div>
</main>

<footer>
  <div class="footer__row">
    <a href="/">приехали.ком</a>
    <span class="footer__muted">© 2026</span>
  </div>
</footer>
<script is:inline>
  const FAV_KEY = 'priehali_favorites';
  function getFavs(){ try{ return JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e){ return []; } }
  function saveFavs(list){ localStorage.setItem(FAV_KEY, JSON.stringify(list)); }
  function isFav(url){ return getFavs().some(f=>f.url===url); }
  function toggleFav(btn){
    const url=btn.dataset.url, title=btn.dataset.title, icon=btn.dataset.icon;
    let list=getFavs();
    if(list.some(f=>f.url===url)){ list=list.filter(f=>f.url!==url); btn.classList.remove('on'); btn.textContent='♡'; }
    else { list.push({url,title,icon}); btn.classList.add('on'); btn.textContent='♥'; }
    saveFavs(list);
  }
  document.querySelectorAll('.favbtn').forEach(btn=>{
    const on=isFav(btn.dataset.url);
    btn.classList.toggle('on',on);
    btn.textContent=on?'♥':'♡';
  });
</script>
</body>
</html>
