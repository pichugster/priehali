---
import topics from '../../../data/topics.js';
import articles from '../../../data/articles.js';

export function getStaticPaths() {
  return articles.map((a) => {
    const topic = topics.find((t) => t.rubric === a.rubric && t.slug === a.category);
    return {
      params: { rubric: a.rubric, category: a.category, article: a.slug },
      props: {
        article: a,
        topic,
        related: articles.filter(
          (x) => x.rubric === a.rubric && x.category === a.category && x.slug !== a.slug
        ),
      },
    };
  });
}

const { article, topic, related } = Astro.props;

// Метка актуальности: считаем по checkedDate, сколько дней прошло с последней проверки
let freshness = null;
if (article.checkedDate) {
  const daysSince = Math.floor((Date.now() - new Date(article.checkedDate).getTime()) / 86400000);
  if (daysSince <= 35) freshness = { label: 'Проверено недавно', cls: 'fresh' };
  else if (daysSince <= 70) freshness = { label: 'Скоро перепроверим', cls: 'stale' };
  else freshness = { label: 'Нужна проверка', cls: 'old' };
}
const dateStr = article.date
  ? new Date(article.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{article.title} — приехали.ком</title>
<meta name="description" content={article.summary}>
<meta name="theme-color" content="#F4F6F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<script nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
  (function () {
      var script = document.createElement("script");
      script.async = 1;
      script.setAttribute("data-cmp-ab","2");
      script.src = 'https://emrldtp.com/NTc0NDU3.js?t=574457';
      document.head.appendChild(script);
  })();
</script>
<style is:global>
  :root{
    --bg:#F4F6F0; --bg-card:#FFFFFF; --ink:#16232B; --ink-soft:#4A5A5F; --line:#DAE1D3;
    --jade:#2F7B6D; --jade-dark:#204F46; --gold:#D9A441;
    --serif:"Newsreader",Georgia,serif; --sans:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif; --maxw:760px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{overflow-x:hidden;max-width:100%}
  img,iframe{max-width:100%}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.7;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  :focus-visible{outline:2px solid var(--jade);outline-offset:2px;border-radius:6px}

  nav{padding:28px 0}
  .nav__row{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .nav__logo{font-family:var(--serif);font-size:1.3rem;font-weight:500;color:var(--jade-dark)}
  .nav__links{display:flex;gap:16px;font-size:.85rem;color:var(--ink-soft);flex-wrap:wrap}
  .nav__links a:hover{color:var(--jade-dark)}
  .nav__tag{font-size:.85rem;color:var(--ink-soft)}

  .crumbs{padding-top:6px;padding-bottom:34px;font-size:.82rem;line-height:1.5;color:var(--ink-soft)}
  .crumbs a{color:var(--jade-dark);font-weight:500}
  .crumbs a:hover{text-decoration:underline}

  main{padding-bottom:60px}
  .rubric-tag{display:inline-block;font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--jade-dark);background:rgba(47,123,109,.1);border-radius:999px;padding:5px 12px;margin-bottom:14px}
  .title-row{display:flex;flex-direction:column;align-items:flex-start;gap:14px}
  .title-row .savebtn{order:2}
  .savebtn{flex:none;display:flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:999px;background:#fff;padding:9px 16px;font-size:.85rem;font-weight:600;color:var(--ink-soft);cursor:pointer;transition:all .15s;margin-top:6px}
  .savebtn:hover{border-color:var(--gold)}
  .savebtn.on{color:var(--gold);border-color:var(--gold);background:rgba(217,164,65,.1)}
  h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.6rem,7vw,2.7rem);line-height:1.1;margin-bottom:14px}
  .lede{font-size:1.08rem;color:var(--ink-soft);margin-bottom:28px}

  .placeholder-photo{background:repeating-linear-gradient(135deg,var(--line) 0 10px,transparent 10px 20px);border:1px solid var(--line);border-radius:16px;height:220px;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:.82rem;margin-bottom:32px}

  .gallery{position:relative;margin-bottom:32px;border-radius:16px;overflow:hidden}
  .gallery__carousel{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none}
  .gallery__carousel::-webkit-scrollbar{display:none}
  .gallery__slide{flex:0 0 100%;scroll-snap-align:start}
  .gallery__slide img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;cursor:zoom-in}
  .gallery__fav,.gallery__share{position:absolute;top:12px;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.92);border:none;display:flex;align-items:center;justify-content:center;font-size:1.05rem;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.15);color:var(--ink)}
  .gallery__fav{right:58px}
  .gallery__share{right:12px}
  .gallery__fav.on{color:#E8452C}
  .gallery__next{position:absolute;top:50%;right:12px;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.85);border:none;font-size:1.2rem;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ink)}
  .gallery__prev{position:absolute;top:50%;left:12px;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.85);border:none;font-size:1.2rem;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ink)}
  .gallery__dots{position:absolute;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:6px}
  .gallery__dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.55)}
  .gallery__dot.is-active{background:#fff;width:16px;border-radius:4px;transition:width .2s}

  .lightbox{display:none;position:fixed;inset:0;background:rgba(10,14,12,.94);z-index:100;align-items:center;justify-content:center;padding:20px;touch-action:pan-y}
  .lightbox.is-open{display:flex}
  .lightbox img{max-width:100%;max-height:100%;object-fit:contain;border-radius:8px;user-select:none;-webkit-user-select:none}
  .lightbox__close{position:absolute;top:16px;right:16px;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.15);border:none;color:#fff;font-size:1.1rem;cursor:pointer;z-index:2}
  .lightbox__prev,.lightbox__next{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.15);border:none;color:#fff;font-size:1.6rem;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2}
  .lightbox__prev{left:12px}
  .lightbox__next{right:12px}

  .embed-widget{margin-bottom:24px}
  .toc{background:var(--bg-card);border:1px solid var(--line);border-radius:14px;padding:16px 20px;margin-bottom:24px}
  .toc__label{display:block;font-size:.66rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
  .toc ol{list-style:none;margin:0;padding:0;counter-reset:toc}
  .toc li{counter-increment:toc;padding:3px 0}
  .toc li::before{content:counter(toc)".";color:var(--jade-dark);font-weight:600;margin-right:7px}
  .toc a{font-size:.88rem;color:var(--ink)}
  .toc a:hover{color:var(--jade-dark)}
  .map-block{margin:32px 0}
  .map-label{display:block;font-size:.66rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
  .map-block iframe{border-radius:14px;display:block}
  .meta-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
  .meta-date{font-size:.78rem;color:var(--ink-soft)}
  .freshness{font-size:.68rem;font-weight:600;letter-spacing:.03em;padding:3px 10px;border-radius:999px}
  .freshness--fresh{background:rgba(47,123,109,.12);color:var(--jade-dark)}
  .freshness--stale{background:rgba(217,164,65,.15);color:#8a6416}
  .freshness--old{background:rgba(217,90,74,.14);color:#a8402f}

  article h2{font-family:var(--serif);font-weight:500;font-size:1.4rem;margin:30px 0 12px}
  article p{margin-bottom:16px;color:var(--ink)}
  article ul{margin:0 0 16px 20px}
  article li{margin-bottom:8px;color:var(--ink)}


  .siblings{margin-top:48px;border-top:1px solid var(--line);padding-top:28px}
  .siblings h3{font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:14px}
  .sib-list{display:flex;flex-wrap:wrap;gap:8px}
  .sib{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;font-size:.86rem;color:var(--ink);transition:border-color .15s}
  .sib:hover{border-color:var(--jade)}

  footer{padding:24px 0 40px;border-top:1px solid var(--line)}
  .footer__row{display:flex;justify-content:space-between;max-width:var(--maxw);margin:0 auto;padding:0 24px;font-family:var(--serif);color:var(--jade-dark)}
  .footer__muted{font-family:var(--sans);color:var(--ink-soft);font-size:.85rem}
</style>
</head>
<body>
<nav>
  <div class="nav__row">
    <a class="nav__logo" href="/">приехали.ком</a>
    <div class="nav__links">
      <a href="/blog/">Блог</a>
      <a href="/news/">Новости</a>
      <a href="/events/">События</a>
      <a href="/qa/">Вопрос-ответ</a>
      <a href="/favorites/">♡ Избранное</a>
    </div>
  </div>
</nav>

<div class="wrap crumbs">
  <a href="/">Приехали</a> / <a href={`/#${topic.rubric}`}>{topic.rubricLabel}</a> / <a href={`/${topic.rubric}/${topic.slug}/`}>{topic.title}</a> / {article.title}
</div>

<main class="wrap">
  <div class="title-row">
    <div>
      <span class="rubric-tag">{topic.title}</span>
      <h1>{article.title}</h1>
    </div>
    <button class="savebtn" id="saveBtn" data-url={Astro.url.pathname} data-title={article.title} data-icon={article.icon}>
      <span id="saveIcon">♡</span> <span id="saveLabel">Сохранить</span>
    </button>
  </div>

  {(dateStr || freshness) && (
    <div class="meta-line">
      {dateStr && <span class="meta-date">Опубликовано {dateStr}</span>}
      {freshness && <span class={`freshness freshness--${freshness.cls}`}>{freshness.label}</span>}
    </div>
  )}

  <p class="lede">{article.hook || article.summary}</p>

  {article.embed && (
    <div class="embed-widget" set:html={article.embed} />
  )}

  {article.toc && (
    <nav class="toc">
      <span class="toc__label">Содержание</span>
      <ol>
        {article.toc.map((t) => (<li><a href={`#${t.id}`}>{t.label}</a></li>))}
      </ol>
    </nav>
  )}

  {article.images && article.images.length > 0 ? (
    <div class="gallery" id="gallery">
      <div class="gallery__carousel" id="galleryTrack">
        {article.images.map((src, i) => (
          <div class="gallery__slide">
            <img src={src} alt={`${article.title} — фото ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} onclick={`openLightbox(${i})`} />
          </div>
        ))}
      </div>

      <button class="gallery__fav" id="galleryFav" aria-label="В избранное">
        <span id="galleryFavIcon">♡</span>
      </button>
      <button class="gallery__share" id="galleryShare" aria-label="Поделиться">⇪</button>

      {article.images.length > 1 && (
        <>
          <button class="gallery__prev" id="galleryPrev" aria-label="Предыдущее фото">‹</button>
          <button class="gallery__next" id="galleryNext" aria-label="Следующее фото">›</button>
          <div class="gallery__dots" id="galleryDots">
            {article.images.map((_, i) => (
              <span class={`gallery__dot ${i === 0 ? 'is-active' : ''}`}></span>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="lightbox" id="lightbox">
      <button class="lightbox__close" id="lightboxClose" aria-label="Закрыть">✕</button>
      {article.images.length > 1 && (
        <>
          <button class="lightbox__prev" id="lightboxPrev" aria-label="Предыдущее фото">‹</button>
          <button class="lightbox__next" id="lightboxNext" aria-label="Следующее фото">›</button>
        </>
      )}
      <img id="lightboxImg" src="" alt="" />
    </div>
  ) : (
    <div class="placeholder-photo">Фото сюда</div>
  )}

  <article>
    <Fragment set:html={article.body} />
  </article>

  {article.map && (
    <div class="map-block">
      <span class="map-label">Где это находится</span>
      <iframe
        src={`https://www.google.com/maps?q=${encodeURIComponent(article.map)}&output=embed`}
        width="100%" height="320" style="border:0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      />
    </div>
  )}

  <div class="siblings">
    <h3>Другие статьи в теме «{topic.title}»</h3>
    <div class="sib-list">
      {related.map((r) => (
        <a class="sib" href={`/${r.rubric}/${r.category}/${r.slug}/`}>{r.icon} {r.title}</a>
      ))}
    </div>
  </div>
</main>

<footer>
  <div class="footer__row">
    <a href="/">приехали.ком</a>
    <span class="footer__muted">© 2026</span>
  </div>
</footer>
<script define:vars={{ galleryImages: article.images || [] }}>
  const FAV_KEY = 'priehali_favorites';
  function getFavs(){ try{ return JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e){ return []; } }
  function saveFavs(list){ localStorage.setItem(FAV_KEY, JSON.stringify(list)); }
  const saveBtn=document.getElementById('saveBtn'), saveIcon=document.getElementById('saveIcon'), saveLabel=document.getElementById('saveLabel');
  const url=saveBtn.dataset.url, title=saveBtn.dataset.title, icon=saveBtn.dataset.icon;

  const galleryFav = document.getElementById('galleryFav');
  const galleryFavIcon = document.getElementById('galleryFavIcon');

  function refresh(){
    const on=getFavs().some(f=>f.url===url);
    saveBtn.classList.toggle('on',on);
    saveIcon.textContent=on?'♥':'♡';
    saveLabel.textContent=on?'Сохранено':'Сохранить';
    if(galleryFav){
      galleryFav.classList.toggle('on',on);
      galleryFavIcon.textContent=on?'♥':'♡';
    }
  }
  function toggleFavorite(){
    let list=getFavs();
    if(list.some(f=>f.url===url)) list=list.filter(f=>f.url!==url);
    else list.push({url,title,icon});
    saveFavs(list);
    refresh();
  }
  saveBtn.addEventListener('click',toggleFavorite);
  if(galleryFav) galleryFav.addEventListener('click',toggleFavorite);
  refresh();

  // Шеринг
  const galleryShare = document.getElementById('galleryShare');
  if(galleryShare){
    galleryShare.addEventListener('click', async () => {
      const shareData = { title, url: location.href };
      if(navigator.share){
        try{ await navigator.share(shareData); }catch(e){}
      } else {
        try{
          await navigator.clipboard.writeText(location.href);
          galleryShare.textContent='✓';
          setTimeout(()=>{ galleryShare.textContent='⇪'; }, 1500);
        }catch(e){}
      }
    });
  }

  // Карусель: точки + стрелки
  const track = document.getElementById('galleryTrack');
  const dots = document.querySelectorAll('.gallery__dot');
  const nextBtn = document.getElementById('galleryNext');
  const prevBtn = document.getElementById('galleryPrev');
  function currentSlide(){ return Math.round(track.scrollLeft / track.clientWidth); }
  function goToSlide(i){
    const clamped = Math.max(0, Math.min(dots.length - 1, i));
    track.scrollTo({ left: clamped * track.clientWidth, behavior: 'smooth' });
  }
  if(track && dots.length){
    track.addEventListener('scroll', () => {
      const idx = currentSlide();
      dots.forEach((d,i)=>d.classList.toggle('is-active', i===idx));
    }, { passive: true });
    if(nextBtn) nextBtn.addEventListener('click', () => goToSlide(currentSlide() + 1));
    if(prevBtn) prevBtn.addEventListener('click', () => goToSlide(currentSlide() - 1));
  }

  // Лайтбокс
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const lightboxClose = document.getElementById('lightboxClose');
  const lightboxPrev = document.getElementById('lightboxPrev');
  const lightboxNext = document.getElementById('lightboxNext');
  let lbIndex = 0;

  function showLightboxImage(){
    lightboxImg.src = galleryImages[lbIndex];
  }
  window.openLightbox = function(i){
    if(!lightbox || !galleryImages[i]) return;
    lbIndex = i;
    showLightboxImage();
    lightbox.classList.add('is-open');
  };
  window.closeLightbox = function(){
    if(lightbox) lightbox.classList.remove('is-open');
  };
  function lbNext(){ lbIndex = (lbIndex + 1) % galleryImages.length; showLightboxImage(); }
  function lbPrev(){ lbIndex = (lbIndex - 1 + galleryImages.length) % galleryImages.length; showLightboxImage(); }

  if(lightboxClose) lightboxClose.addEventListener('click', (e) => { e.stopPropagation(); closeLightbox(); });
  if(lightboxNext) lightboxNext.addEventListener('click', (e) => { e.stopPropagation(); lbNext(); });
  if(lightboxPrev) lightboxPrev.addEventListener('click', (e) => { e.stopPropagation(); lbPrev(); });
  if(lightbox){
    // клик по фону/фото закрывает, но не по кнопкам навигации
    lightbox.addEventListener('click', (e) => {
      if(e.target === lightbox || e.target === lightboxImg) closeLightbox();
    });
    // свайп влево/вправо
    let touchStartX = 0;
    lightbox.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].clientX; }, { passive: true });
    lightbox.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if(Math.abs(dx) > 40){
        if(dx < 0) lbNext(); else lbPrev();
      }
    }, { passive: true });
  }
</script>
</body>
</html>
