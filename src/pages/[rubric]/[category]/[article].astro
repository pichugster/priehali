---
import topics from '../../../data/topics.js';
import articles from '../../../data/articles.js';

export function getStaticPaths() {
  return articles.map((a) => {
    const topic = topics.find((t) => t.rubric === a.rubric && t.slug === a.category);
    return {
      params: { rubric: a.rubric, category: a.category, article: a.slug },
      props: {
        article: a,
        topic,
        related: articles.filter(
          (x) => x.rubric === a.rubric && x.category === a.category && x.slug !== a.slug
        ),
      },
    };
  });
}

const { article, topic, related } = Astro.props;

// Метка актуальности: считаем по checkedDate, сколько дней прошло с последней проверки
let freshness = null;
if (article.checkedDate) {
  const daysSince = Math.floor((Date.now() - new Date(article.checkedDate).getTime()) / 86400000);
  if (daysSince <= 35) freshness = { label: 'Проверено недавно', cls: 'fresh' };
  else if (daysSince <= 70) freshness = { label: 'Скоро перепроверим', cls: 'stale' };
  else freshness = { label: 'Нужна проверка', cls: 'old' };
}
const dateStr = article.date
  ? new Date(article.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{article.title} — приехали.ком</title>
<meta name="description" content={article.summary}>
<meta name="theme-color" content="#F4F6F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<script nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
  (function () {
      var script = document.createElement("script");
      script.async = 1;
      script.setAttribute("data-cmp-ab","2");
      script.src = 'https://emrldtp.com/NTc0NDU3.js?t=574457';
      document.head.appendChild(script);
  })();
</script>
<style is:global>
  :root{
    --bg:#F4F6F0; --bg-card:#FFFFFF; --ink:#16232B; --ink-soft:#4A5A5F; --line:#DAE1D3;
    --jade:#2F7B6D; --jade-dark:#204F46; --gold:#D9A441;
    --serif:"Newsreader",Georgia,serif; --sans:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif; --maxw:760px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{overflow-x:hidden;max-width:100%}
  img,iframe{max-width:100%}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.7;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  :focus-visible{outline:2px solid var(--jade);outline-offset:2px;border-radius:6px}

  nav{padding:28px 0}
  .nav__row{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .nav__logo{font-family:var(--serif);font-size:1.3rem;font-weight:500;color:var(--jade-dark)}
  .nav__links{display:flex;gap:16px;font-size:.85rem;color:var(--ink-soft);flex-wrap:wrap}
  .nav__links a:hover{color:var(--jade-dark)}
  .nav__tag{font-size:.85rem;color:var(--ink-soft)}

  .crumbs{padding:6px 0 26px;font-size:.82rem;color:var(--ink-soft)}
  .crumbs a{color:var(--jade-dark);font-weight:500}
  .crumbs a:hover{text-decoration:underline}

  main{padding-bottom:60px}
  .rubric-tag{display:inline-block;font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--jade-dark);background:rgba(47,123,109,.1);border-radius:999px;padding:5px 12px;margin-bottom:14px}
  .title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
  .savebtn{flex:none;display:flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:999px;background:#fff;padding:9px 16px;font-size:.85rem;font-weight:600;color:var(--ink-soft);cursor:pointer;transition:all .15s;margin-top:6px}
  .savebtn:hover{border-color:var(--gold)}
  .savebtn.on{color:var(--gold);border-color:var(--gold);background:rgba(217,164,65,.1)}
  h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.6rem,7vw,2.7rem);line-height:1.1;margin-bottom:14px}
  .lede{font-size:1.08rem;color:var(--ink-soft);margin-bottom:28px}

  .placeholder-photo{background:repeating-linear-gradient(135deg,var(--line) 0 10px,transparent 10px 20px);border:1px solid var(--line);border-radius:16px;height:220px;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:.82rem;margin-bottom:32px}
  .article-photo{width:100%;max-height:420px;object-fit:cover;border-radius:16px;margin-bottom:32px;display:block}
  .embed-widget{margin-bottom:24px}
  .toc{background:var(--bg-card);border:1px solid var(--line);border-radius:14px;padding:16px 20px;margin-bottom:24px}
  .toc__label{display:block;font-size:.66rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
  .toc ol{list-style:none;margin:0;padding:0;counter-reset:toc}
  .toc li{counter-increment:toc;padding:3px 0}
  .toc li::before{content:counter(toc)".";color:var(--jade-dark);font-weight:600;margin-right:7px}
  .toc a{font-size:.88rem;color:var(--ink)}
  .toc a:hover{color:var(--jade-dark)}
  .map-block{margin:32px 0}
  .map-label{display:block;font-size:.66rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
  .map-block iframe{border-radius:14px;display:block}
  .meta-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
  .meta-date{font-size:.78rem;color:var(--ink-soft)}
  .freshness{font-size:.68rem;font-weight:600;letter-spacing:.03em;padding:3px 10px;border-radius:999px}
  .freshness--fresh{background:rgba(47,123,109,.12);color:var(--jade-dark)}
  .freshness--stale{background:rgba(217,164,65,.15);color:#8a6416}
  .freshness--old{background:rgba(217,90,74,.14);color:#a8402f}

  article h2{font-family:var(--serif);font-weight:500;font-size:1.4rem;margin:30px 0 12px}
  article p{margin-bottom:16px;color:var(--ink)}
  article ul{margin:0 0 16px 20px}
  article li{margin-bottom:8px;color:var(--ink)}

  .edit-note{margin-top:36px;padding:16px 18px;border:1px dashed var(--gold);border-radius:14px;background:rgba(217,164,65,.08);font-size:.86rem;color:var(--ink-soft)}
  .edit-note b{color:var(--ink)}

  .siblings{margin-top:48px;border-top:1px solid var(--line);padding-top:28px}
  .siblings h3{font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:14px}
  .sib-list{display:flex;flex-wrap:wrap;gap:8px}
  .sib{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;font-size:.86rem;color:var(--ink);transition:border-color .15s}
  .sib:hover{border-color:var(--jade)}

  footer{padding:24px 0 40px;border-top:1px solid var(--line)}
  .footer__row{display:flex;justify-content:space-between;max-width:var(--maxw);margin:0 auto;padding:0 24px;font-family:var(--serif);color:var(--jade-dark)}
  .footer__muted{font-family:var(--sans);color:var(--ink-soft);font-size:.85rem}
</style>
</head>
<body>
<nav>
  <div class="nav__row">
    <a class="nav__logo" href="/">приехали.ком</a>
    <div class="nav__links">
      <a href="/blog/">Блог</a>
      <a href="/news/">Новости</a>
      <a href="/events/">События</a>
      <a href="/qa/">Вопрос-ответ</a>
      <a href="/favorites/">♡ Избранное</a>
    </div>
  </div>
</nav>

<div class="wrap crumbs">
  <a href="/">приехали.</a> / <a href={`/#${topic.rubric}`}>{topic.rubricLabel}</a> / <a href={`/${topic.rubric}/${topic.slug}/`}>{topic.title}</a> / {article.title}
</div>

<main class="wrap">
  <div class="title-row">
    <div>
      <span class="rubric-tag">{topic.title}</span>
      <h1>{article.title}</h1>
    </div>
    <button class="savebtn" id="saveBtn" data-url={Astro.url.pathname} data-title={article.title} data-icon={article.icon}>
      <span id="saveIcon">♡</span> <span id="saveLabel">Сохранить</span>
    </button>
  </div>

  {(dateStr || freshness) && (
    <div class="meta-line">
      {dateStr && <span class="meta-date">Опубликовано {dateStr}</span>}
      {freshness && <span class={`freshness freshness--${freshness.cls}`}>{freshness.label}</span>}
    </div>
  )}

  <p class="lede">{article.hook || article.summary}{!article.body && '. Ниже — рыба: замени на свой текст, когда статья будет готова.'}</p>

  {article.embed && (
    <div class="embed-widget" set:html={article.embed} />
  )}

  {article.toc && (
    <nav class="toc">
      <span class="toc__label">Содержание</span>
      <ol>
        {article.toc.map((t) => (<li><a href={`#${t.id}`}>{t.label}</a></li>))}
      </ol>
    </nav>
  )}

  {article.image ? (
    <img class="article-photo" src={article.image} alt={article.title} loading="eager" />
  ) : (
    <div class="placeholder-photo">Фото сюда</div>
  )}

  <article>
    {article.body ? (
      <Fragment set:html={article.body} />
    ) : (
      <>
    <p>
      Здесь начинается основной текст статьи. Опиши в двух-трёх предложениях, о чём пойдёт речь
      и почему читателю стоит дочитать до конца — это первый абзац, который решает, останется он или уйдёт.
    </p>

    <h2>Что нужно знать</h2>
    <p>
      Раздел с сутью: конкретные факты, цифры, названия мест. Пиши коротко и по делу —
      абзацы по 2-3 предложения читаются на телефоне гораздо легче, чем длинные простыни текста.
    </p>
    <ul>
      <li>Первый важный пункт — замени на реальный факт</li>
      <li>Второй пункт — например, конкретное место или цена</li>
      <li>Третий пункт — то, о чём часто спрашивают</li>
    </ul>

    <h2>Личный опыт</h2>
    <p>
      Здесь — то, что отличает эту статью от сотни таких же в интернете: что видел лично,
      что сработало, а что нет. Именно этот раздел читатели запоминают и пересылают друзьям.
    </p>

    <h2>Лайфхак</h2>
    <p>
      Один конкретный совет, который сэкономит время или деньги. Чем конкретнее — тем лучше:
      не «будьте осторожны», а «спрашивай цену заранее, вот так-то».
    </p>
      </>
    )}
  </article>

  {article.map && (
    <div class="map-block">
      <span class="map-label">Где это находится</span>
      <iframe
        src={`https://www.google.com/maps?q=${encodeURIComponent(article.map)}&output=embed`}
        width="100%" height="320" style="border:0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      />
    </div>
  )}

  {!article.body && (
  <div class="edit-note">
    <b>Это рыба.</b> Файл — общий шаблон <code>[rubric]/[category]/[article].astro</code>,
    а конкретный текст этой карточки берётся из <code>src/data/articles.js</code>
    (запись с <code>category: "{topic.slug}"</code>, <code>slug: "{article.slug}"</code>).
  </div>
  )}

  <div class="siblings">
    <h3>Другие статьи в теме «{topic.title}»</h3>
    <div class="sib-list">
      {related.map((r) => (
        <a class="sib" href={`/${r.rubric}/${r.category}/${r.slug}/`}>{r.icon} {r.title}</a>
      ))}
    </div>
  </div>
</main>

<footer>
  <div class="footer__row">
    <a href="/">приехали.ком</a>
    <span class="footer__muted">© 2026</span>
  </div>
</footer>
<script is:inline>
  const FAV_KEY = 'priehali_favorites';
  function getFavs(){ try{ return JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e){ return []; } }
  function saveFavs(list){ localStorage.setItem(FAV_KEY, JSON.stringify(list)); }
  const saveBtn=document.getElementById('saveBtn'), saveIcon=document.getElementById('saveIcon'), saveLabel=document.getElementById('saveLabel');
  const url=saveBtn.dataset.url, title=saveBtn.dataset.title, icon=saveBtn.dataset.icon;

  function refresh(){
    const on=getFavs().some(f=>f.url===url);
    saveBtn.classList.toggle('on',on);
    saveIcon.textContent=on?'♥':'♡';
    saveLabel.textContent=on?'Сохранено':'Сохранить';
  }
  saveBtn.addEventListener('click',()=>{
    let list=getFavs();
    if(list.some(f=>f.url===url)) list=list.filter(f=>f.url!==url);
    else list.push({url,title,icon});
    saveFavs(list);
    refresh();
  });
  refresh();
</script>
</body>
</html>
