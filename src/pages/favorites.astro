<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Избранное — приехали.ком</title>
<meta name="theme-color" content="#F4F6F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<script nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
  (function () {
      var script = document.createElement("script");
      script.async = 1;
      script.setAttribute("data-cmp-ab","2");
      script.src = 'https://emrldtp.com/NTc0NDU3.js?t=574457';
      document.head.appendChild(script);
  })();
</script>
<style is:global>
  :root{
    --bg:#F4F6F0; --bg-card:#FFFFFF; --ink:#16232B; --ink-soft:#4A5A5F; --line:#DAE1D3;
    --jade:#2F7B6D; --jade-dark:#204F46; --gold:#D9A441;
    --serif:"Newsreader",Georgia,serif; --sans:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif; --maxw:1000px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}

  nav{padding:28px 0}
  .nav__row{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .nav__logo{font-family:var(--serif);font-size:1.3rem;font-weight:500;color:var(--jade-dark)}
  .nav__links{display:flex;gap:16px;font-size:.85rem;color:var(--ink-soft)}
  .nav__links a:hover{color:var(--jade-dark)}

  main{padding-bottom:60px}
  h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.9rem,4vw,2.5rem);margin-bottom:8px}
  .lede{color:var(--ink-soft);margin-bottom:30px;font-size:.95rem}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
  .card{position:relative;display:block;background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;transition:transform .2s,box-shadow .2s,border-color .2s}
  .card:hover{transform:translateY(-3px);border-color:var(--jade);box-shadow:0 20px 40px -30px rgba(22,35,43,.4)}
  .card .ic{font-size:1.5rem}
  .card h3{font-weight:600;font-size:1.02rem;margin:10px 0 12px}
  .card .go{font-size:.72rem;letter-spacing:.04em;color:var(--jade-dark);font-weight:600}
  .rmbtn{position:absolute;top:14px;right:14px;width:28px;height:28px;border:1px solid var(--line);border-radius:50%;background:#fff;cursor:pointer;color:var(--ink-soft);font-size:.85rem;display:flex;align-items:center;justify-content:center}
  .rmbtn:hover{border-color:#c0504d;color:#c0504d}

  .empty{text-align:center;padding:60px 20px;color:var(--ink-soft)}
  .empty a{color:var(--jade-dark);font-weight:600}

  footer{padding:24px 0 40px;border-top:1px solid var(--line)}
  .footer__row{display:flex;justify-content:space-between;max-width:var(--maxw);margin:0 auto;padding:0 24px;font-family:var(--serif);color:var(--jade-dark)}
  .footer__muted{font-family:var(--sans);color:var(--ink-soft);font-size:.85rem}
</style>
</head>
<body>
<nav>
  <div class="nav__row">
    <a class="nav__logo" href="/">приехали.ком</a>
    <div class="nav__links">
      <a href="/news/">Новости</a>
      <a href="/events/">События</a>
      <a href="/qa/">Вопрос-ответ</a>
      <a href="/favorites/">♡ Избранное</a>
    </div>
  </div>
</nav>

<main class="wrap">
  <h1>♡ Избранное</h1>
  <p class="lede">Сохраняется в этом браузере. Если очистишь историю или зайдёшь с другого устройства — список будет пустым (пока нет аккаунтов).</p>
  <div id="grid" class="grid"></div>
  <div id="empty" class="empty" style="display:none">
    Пока пусто. <a href="/">Вернись на главную</a> и жми ♡ на понравившихся темах и статьях.
  </div>
</main>

<footer>
  <div class="footer__row">
    <a href="/">приехали.ком</a>
    <span class="footer__muted">© 2026</span>
  </div>
</footer>

<script is:inline>
  const FAV_KEY = 'priehali_favorites';
  function getFavs(){ try{ return JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e){ return []; } }
  function saveFavs(list){ localStorage.setItem(FAV_KEY, JSON.stringify(list)); }

  function render(){
    const list = getFavs();
    const grid = document.getElementById('grid');
    const empty = document.getElementById('empty');
    if(list.length === 0){ grid.style.display='none'; empty.style.display='block'; return; }
    grid.style.display='grid'; empty.style.display='none';
    grid.innerHTML = list.map(f => `
      <a class="card" href="${f.url}">
        <button class="rmbtn" data-url="${f.url}" onclick="event.preventDefault();event.stopPropagation();removeFav(this)" aria-label="Убрать из избранного">✕</button>
        <div class="ic">${f.icon || '📌'}</div>
        <h3>${f.title}</h3>
        <span class="go">Открыть →</span>
      </a>
    `).join('');
  }
  function removeFav(btn){
    const url = btn.dataset.url;
    saveFavs(getFavs().filter(f => f.url !== url));
    render();
  }
  render();
</script>
</body>
</html>
